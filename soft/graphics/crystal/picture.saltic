-- picture — кадр кристалла: камера смотрит вдоль z, на каждый пиксель —
-- луч через tracer, яркость — номер цвета палитры «чёрный → глубокая
-- бирюза → бирюза → белый». Ход — в консоль каждые EVERY строк.
--
-- Picture { light, width, height, zoom, eye, math } — light — tracer.Tracer,
--     eye — место камеры [x, y, z], math — vector.Vector
--     sample(x, y) -> яркость луча через точку экрана (дробные координаты)
--     render_frame() -> буфер core.bytes номеров цветов width × height, края
--         сглажены; edge(pixels, x, y) -> yes на краю; apart(a, b) -> далеки ли
--     shade(value) -> номер цвета 0…255 по яркости (корень — мягче к тёмному)
--     palette() -> группа [r, g, b] из 256 цветов
--     between(from, to, part, whole) -> [r, g, b] на part/whole пути от from к to
-- DEPTH — глубина луча; EDGE — разница цветов, с которой пиксель — край;
-- QUARTER — сдвиг лучей сглаживания; BRIGHT — яркость, что становится белым;
-- BLACK, DEEP, CYAN, WHITE — опорные цвета палитры

use core.num
use core.bytes
use core.group
use core.fraction
use tarantul.vector.vector
use soft.graphics.crystal.tracer

DEPTH = 7
EDGE = 12
QUARTER = 0.25
BRIGHT = 1.1
BLACK = [0, 0, 0]
DEEP = [0, 62, 88]
CYAN = [38, 196, 232]
WHITE = [236, 253, 255]

Picture = Box {
    light = tracer.Tracer {},
    width = 720,
    height = 960,
    zoom = 0.9,
    eye = [0.0, 0.15, -6.5],
    math = vector.Vector {}

    skill sample(x, y) {
        @high = fraction.from(height)
        @across = (x - fraction.from(width) / 2.0) / high * zoom
        @up = (high / 2.0 - y) / high * zoom
        out light.trace(eye, math.unit([across, up, 1.0]), no, DEPTH, 1.0)
    }

    skill render_frame() {
        @pixels = bytes.new(width * height)
        drum (height) {
            @row = beat
            drum (width) {
                bytes.set(pixels, row * width + beat, shade(sample(fraction.from(beat), fraction.from(row))))
            }
        }
        @smooth = bytes.new(width * height)
        drum (height) {
            @row = beat
            drum (width) {
                @at = row * width + beat
                @value = bytes.get(pixels, at)
                (edge(pixels, beat, row) == yes) {
                    @x = fraction.from(beat)
                    @y = fraction.from(row)
                    @sum = sample(x - QUARTER, y - QUARTER) + sample(x + QUARTER, y - QUARTER) + sample(x - QUARTER, y + QUARTER) + sample(x + QUARTER, y + QUARTER)
                    value = shade(sum / 4.0)
                }
                bytes.set(smooth, at, value)
            }
        }
        out smooth
    }

    skill edge(pixels, x, y) {
        @here = bytes.get(pixels, y * width + x)
        (x > 0) {
            (apart(here, bytes.get(pixels, y * width + x - 1)) == yes) {
                out yes
            }
        }
        ((x + 1) < width) {
            (apart(here, bytes.get(pixels, y * width + x + 1)) == yes) {
                out yes
            }
        }
        (y > 0) {
            (apart(here, bytes.get(pixels, (y - 1) * width + x)) == yes) {
                out yes
            }
        }
        ((y + 1) < height) {
            (apart(here, bytes.get(pixels, (y + 1) * width + x)) == yes) {
                out yes
            }
        }
        out no
    }

    skill apart(a, b) {
        @gap = a - b
        (gap < 0) {
            gap = 0 - gap
        }
        out (gap > EDGE)
    }

    skill shade(value) {
        @part = value / BRIGHT
        (part < 0.0) {
            out 0
        }
        (part > 1.0) {
            out 255
        }
        out num.round_school(fraction.sqrt(part) * 255.0)
    }

    skill palette() {
        @colors = []
        drum (256) {
            @color = between(DEEP, CYAN, beat - 102, 102)
            (beat < 102) {
                color = between(BLACK, DEEP, beat, 102)
            }
            (beat > 204) {
                color = between(CYAN, WHITE, beat - 204, 51)
            }
            colors = group.add(colors, color)
        }
        out colors
    }

    skill between(from, to, part, whole) {
        @mixed = []
        drum (3) {
            @start = group.get(from, beat)
            mixed = group.add(mixed, start + (group.get(to, beat) - start) * part / whole)
        }
        out mixed
    }
}
