-- space — вся математика пространства кристалла. Точка и направление —
-- группы [x, y, z] дробных: так дробные проходят через вызовы без потери
-- типа (результат метода тип Box теряет). Хозяева
-- держат Space полем и зовут его навыки.
--
-- Space {} — part(a, index) -> координата как дробное (0.0 + …: без этого
--     компилятор не знает тип и ставит целую операцию); plus(a, b) / minus(a, b) -> [x, y, z]; scaled(a, k) -> a, умноженное
--     на дробное k; dot(a, b) -> дробное; cross(a, b) -> [x, y, z]; unit(a) ->
--     длины 1 (нулевое — нулевое); along(origin, direction, t) -> точка луча
--     на расстоянии t
-- TINY — меньше этой длины вектор считается нулевым

use core.group
use core.fraction

TINY = 0.000000001

Space = Box {
    skill part(a, index) {
        out 0.0 + group.get(a, index)
    }

    skill plus(a, b) {
        out [part(a, 0) + part(b, 0), part(a, 1) + part(b, 1), part(a, 2) + part(b, 2)]
    }

    skill minus(a, b) {
        out [part(a, 0) - part(b, 0), part(a, 1) - part(b, 1), part(a, 2) - part(b, 2)]
    }

    skill scaled(a, k) {
        out [part(a, 0) * k, part(a, 1) * k, part(a, 2) * k]
    }

    skill dot(a, b) {
        out part(a, 0) * part(b, 0) + part(a, 1) * part(b, 1) + part(a, 2) * part(b, 2)
    }

    skill cross(a, b) {
        @ax = part(a, 0)
        @ay = part(a, 1)
        @az = part(a, 2)
        @bx = part(b, 0)
        @by = part(b, 1)
        @bz = part(b, 2)
        out [ay * bz - az * by, az * bx - ax * bz, ax * by - ay * bx]
    }

    skill unit(a) {
        @length = fraction.sqrt(dot(a, a))
        (length < TINY) {
            out [0.0, 0.0, 0.0]
        }
        out scaled(a, 1.0 / length)
    }

    skill along(origin, direction, t) {
        out plus(origin, scaled(direction, t))
    }
}
