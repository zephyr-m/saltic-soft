-- main — вход «Кристалла» (soft/graphics/crystal): огранённый кристалл со
-- стеклом, преломлением и полным внутренним отражением, трассировкой лучей
-- на дробных, в окне Wayland. Кадры считают работники — та же программа,
-- запущенная с номерами кадров (/proc/self/exe "3 11 19"): процессы, каждый
-- на своём ядре, без общей памяти — как работники PHP-FPM. Готовые кадры
-- лежат в кеше (studio): следующий запуск крутит сразу. Окно крутит готовые
-- по мере появления, все FRAMES — бесшовной петлёй с частотой FPS.
--
-- Window { canvas, link, reader, workshop, colors, frames, waiting, started,
--     shown, packet, hold, joined } — окно и всё долгое; frames — кадры
--     по номерам ([] — ещё нет); waiting — сколько кадров ещё не готово
--     open() — окно, палитра, кеш, работники на недостающие кадры; NoWindow
--     hire() — запустить WORKERS работников на кадры, которых нет в кеше
--     collect() — подобрать кадры, которые работники дописали
--     draw(pixels) — кадр в окно; play() — показать кадр по часам
--     turn() -> no, когда пора выходить
-- program(task) — task WINDOW («window») — окно; иначе — работник: номера
--     кадров через пробел
-- WINDOW — слово режима окна; WORKERS — сколько работников; FPS — кадров в
-- секунду; TICK — пауза хода

use io
use core.u32
use core.mem
use core.str
use core.usize
use core.address
use core.bytes
use core.group
use core.socket
use core.time
use core.process
use tarantul.wayland.wayland.screen
use tarantul.graphics.graphics
use tarantul.input.gestures
use soft.graphics.crystal.studio

TITLE = "Кристалл"
WINDOW = "window"
WORKERS = 8
FPS = 24
TICK = 10
SELF = "/proc/self/exe"

Window = Box {
    canvas = graphics.Screen {},
    link = screen.Link {},
    reader = gestures.Reader {},
    workshop = studio.Studio {},
    colors = [],
    frames = [],
    waiting = 0,
    started = 0,
    shown = -1,
    packet = bytes.new(8192),
    hold = bytes.new(4096),
    joined = bytes.new(12288)

    skill open() {
        @host = screen.sized(TITLE, workshop.frame.width, workshop.frame.height)
        (group.count(host) == 0) {
            out error.NoWindow
        }
        canvas = group.get(host, 0)
        link = group.get(host, 1)
        @look = workshop.frame
        @entries = look.palette()
        drum (entries) {
            @entry = group.get(entries, beat)
            colors = group.add(colors, graphics.color(canvas, group.get(entry, 0), group.get(entry, 1), group.get(entry, 2)))
        }
        graphics.fill(canvas, 0, 0, canvas.width, canvas.height, graphics.color(canvas, 0, 0, 0))
        started = time.now()
        drum (studio.FRAMES) {
            frames = group.add(frames, [])
        }
        collect()
        (waiting > 0) {
            hire()
        }
        out none
    }

    skill hire() {
        @lists = []
        drum (WORKERS) {
            lists = group.add(lists, "")
        }
        drum (studio.FRAMES) {
            (group.count(group.get(frames, beat)) == 0) {
                @slot = beat % WORKERS
                @list = group.get(lists, slot)
                lists = group.replaced(lists, slot, "{list} {beat}")
            }
        }
        drum (lists) {
            @list_2 = group.get(lists, beat)
            (str.bytes(list_2) > 0) {
                process.open(SELF, [SELF, list_2], "", no, process.environment_with([]), no)
            }
        }
        @folder = studio.FOLDER
        out io.show("кристалл: считают {WORKERS} работников, кадров {waiting} — кеш в {folder}")
    }

    skill collect() {
        waiting = 0
        drum (studio.FRAMES) {
            (group.count(group.get(frames, beat)) == 0) {
                @found = workshop.cached(beat)
                pick {
                    (group.count(found) > 0) {
                        frames = group.replaced(frames, beat, found)
                    }
                    {
                        waiting = waiting + 1
                    }
                }
            }
        }
        out none
    }

    skill draw(pixels) {
        @memory = address.from(canvas.memory)
        @wide = workshop.frame.width
        drum (workshop.frame.height) {
            @y = beat
            @line = y * canvas.stride * graphics.PIXEL_BYTES
            drum (wide) {
                @value = u32.from(group.get(colors, bytes.get(pixels, y * wide + beat)))
                mem.store32(memory, usize.from(line + beat * graphics.PIXEL_BYTES), value)
            }
        }
        out none
    }

    skill play() {
        @ready = []
        drum (frames) {
            @frame = group.get(frames, beat)
            (group.count(frame) > 0) {
                ready = group.add(ready, group.get(frame, 0))
            }
        }
        (group.count(ready) == 0) {
            out none
        }
        @spent = time.now() - started
        (spent < 0) {
            spent = spent + time.DAY_MILLISECONDS
        }
        @index = (spent * FPS / 1000) % group.count(ready)
        (index == shown) {
            out none
        }
        shown = index
        draw(group.get(ready, index))
        out screen.present(link)
    }

    skill turn() {
        ((link.way_closed == yes) ○○ (link.way_failed == yes)) {
            out no
        }
        screen.pump(link, packet, hold, joined)
        @drained = reader.drain(link.way_events)
        link.way_events = drained.core
        (waiting > 0) {
            @before = waiting
            collect()
            ((waiting == before) == no) {
                shown = -1
                @done = studio.FRAMES - waiting
                @total = studio.FRAMES
                io.show("кристалл: готово кадров {done} из {total}")
            }
        }
        play()
        socket.sleep(TICK)
        out yes
    }
}

program(task) {
    @workshop = studio.Studio {}
    workshop.prepare()
    ((task == WINDOW) == no) {
        @entries = str.split(task, " ")
        drum (entries) {
            @entry = group.get(entries, beat)
            workshop.save(workshop.index_of(entry))
        }
        out none
    }
    @window = Window {}
    window.workshop = workshop
    window.open()
    always {
        (window.turn() == no) {
            leave
        }
    }
    out none
}
