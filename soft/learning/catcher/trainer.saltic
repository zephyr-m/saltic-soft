-- trainer — урок «Ловца»: эпизод за вызовом — мяч падает, агент
-- (soft/learning/agent) ловит и учится. Любопытство падает от 1000 ‰ до
-- EPSILON_LOW за EXPLORE эпизодов. Раз в REPORT эпизодов — доля пойманных в
-- history и строкой в журнал.
--
-- Trainer { student, game, caught, episode, chance, history } —
--     start(seed) — новая сеть HIDDEN нейронов; episode_once() — эпизод с
--     учёбой; done() -> yes после EPISODES; greedy(state) -> лучший ход
--     сети
-- EPISODES, EXPLORE, EPSILON_LOW, REPORT, HIDDEN

use io
use core.group
use soft.learning.agent
use soft.learning.catcher.field

EPISODES = 1500
EXPLORE = 600
EPSILON_LOW = 50
REPORT = 50
HIDDEN = 32

Trainer = Box {
    student = agent.Agent {},
    game = field.Field {},
    caught = 0,
    episode = 0,
    chance = 1000,
    history = []

    skill start(seed) {
        out student.born(seed, 3, HIDDEN, 3)
    }

    skill done() {
        out (episode >= EPISODES)
    }

    skill greedy(state) {
        out student.greedy(state)
    }

    skill episode_once() {
        episode = episode + 1
        chance = 1000 - (1000 - EPSILON_LOW) * episode / EXPLORE
        (chance < EPSILON_LOW) {
            chance = EPSILON_LOW
        }
        student.curious(chance)
        game.fresh(student.dice)
        drum (field.HIGH) {
            (game.over() == no) {
                @state = game.state()
                @action = student.chosen(state)
                @reward = game.move(action)
                student.observe(state, action, reward, game.state(), game.over())
                (reward > 0) {
                    caught = caught + 1
                }
            }
        }
        ((episode % REPORT) == 0) {
            @percent = caught * 100 / REPORT
            history = group.add(history, percent)
            @curious = chance / 10
            io.show("ловец: эпизод {episode} — поймала {percent} %, любопытство {curious} %")
            caught = 0
        }
        out none
    }
}
