-- net — маленькая полносвязная сеть «Ловца»: INPUTS → HIDDEN (ReLU) →
-- ACTIONS, выход — ценность каждого действия (Q). Веса — группа [w1, b1, w2,
-- b2] групп дробных: w1 — HIDDEN строк по INPUTS, w2 — ACTIONS строк по HIDDEN.
-- Учится одним снимком: ошибка — половина квадрата разницы только у
-- выбранного действия, шаг спуска rate. Числа из групп начинаются с 1.0 * /
-- 0.0 +: чекер иначе считает их целыми.
--
-- fresh(dice) -> веса со случайными значениями (He: ±sqrt(6 / входов) ≈ LIMIT)
-- values(weights, state) -> [скрытый слой, ценности действий]
-- best(values) -> номер действия с наибольшей ценностью; most(values) -> она
-- learned(weights, state, action, target, rate) -> новые веса
-- INPUTS, HIDDEN, ACTIONS — размеры; LIMIT_IN, LIMIT_HIDDEN — разброс весов

use core.group
use core.fraction

INPUTS = 3
HIDDEN = 32
ACTIONS = 3
LIMIT_IN = 1.4
LIMIT_HIDDEN = 0.43

skill spread(dice, count, limit) {
    @made = []
    drum (count) {
        made = group.add(made, fraction.from(dice.below(2001) - 1000) / 1000.0 * limit)
    }
    out made
}

skill zeros_of(count) {
    @made = []
    drum (count) {
        made = group.add(made, 0.0)
    }
    out made
}

skill fresh(dice) {
    out [spread(dice, HIDDEN * INPUTS, LIMIT_IN), zeros_of(HIDDEN), spread(dice, ACTIONS * HIDDEN, LIMIT_HIDDEN), zeros_of(ACTIONS)]
}

skill values(weights, state) {
    @w1 = group.get(weights, 0)
    @b1 = group.get(weights, 1)
    @w2 = group.get(weights, 2)
    @b2 = group.get(weights, 3)
    @hidden = []
    drum (HIDDEN) {
        @row = beat
        @sum = 0.0 + group.get(b1, row)
        drum (INPUTS) {
            sum = sum + 1.0 * group.get(w1, row * INPUTS + beat) * group.get(state, beat)
        }
        (sum < 0.0) {
            sum = 0.0
        }
        hidden = group.add(hidden, sum)
    }
    @answer = []
    drum (ACTIONS) {
        @row = beat
        @sum = 0.0 + group.get(b2, row)
        drum (HIDDEN) {
            sum = sum + 1.0 * group.get(w2, row * HIDDEN + beat) * group.get(hidden, beat)
        }
        answer = group.add(answer, sum)
    }
    out [hidden, answer]
}

skill best(answer) {
    @chosen = 0
    @top = 0.0 + group.get(answer, 0)
    drum (group.count(answer)) {
        @value = 0.0 + group.get(answer, beat)
        (value > top) {
            top = value
            chosen = beat
        }
    }
    out chosen
}

skill most(answer) {
    out 0.0 + group.get(answer, best(answer))
}

skill learned(weights, state, action, target, rate) {
    @pass = values(weights, state)
    @hidden = group.get(pass, 0)
    @answer = group.get(pass, 1)
    @w1 = group.get(weights, 0)
    @b1 = group.get(weights, 1)
    @w2 = group.get(weights, 2)
    @b2 = group.get(weights, 3)
    @delta = (0.0 + group.get(answer, action) - target) * rate
    @back = []
    drum (HIDDEN) {
        @push = 0.0
        ((0.0 + group.get(hidden, beat)) > 0.0) {
            push = delta * group.get(w2, action * HIDDEN + beat)
        }
        back = group.add(back, push)
    }
    @new_w2 = []
    drum (ACTIONS * HIDDEN) {
        @value = 0.0 + group.get(w2, beat)
        ((beat / HIDDEN) == action) {
            value = value - delta * group.get(hidden, beat % HIDDEN)
        }
        new_w2 = group.add(new_w2, value)
    }
    @new_b2 = group.replaced(b2, action, 0.0 + group.get(b2, action) - delta)
    @new_w1 = []
    drum (HIDDEN * INPUTS) {
        new_w1 = group.add(new_w1, 0.0 + group.get(w1, beat) - 1.0 * group.get(back, beat / INPUTS) * group.get(state, beat % INPUTS))
    }
    @new_b1 = []
    drum (HIDDEN) {
        new_b1 = group.add(new_b1, 0.0 + group.get(b1, beat) - group.get(back, beat))
    }
    out [new_w1, new_b1, new_w2, new_b2]
}
