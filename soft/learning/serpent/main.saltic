-- main — «Змея учится» в окне Wayland: сеть (soft/learning/agent, DQN с нуля)
-- учится играть в нашу «Змейку» (arena поверх soft/games/snake) — учёба идёт
-- шагами, пока на кадр не уйдёт BUDGET мс, а на поле живая партия текущей сети
-- без любопытства, ход раз в MOVE_GAP мс: видно, как змея сначала бьётся о
-- стену, потом ищет яблоки. Справа столбики: средний счёт за каждые
-- trainer.REPORT партий (последние BARS). Учёба не кончается. «×» окна —
-- выход. Пока только Linux.
--
-- Window { canvas, link, palette, reader, teacher, show, clock, move_wait,
--     shown_best, packet, hold, joined } — окно и всё долгое
--     open() — окно, шрифты, новая сеть; NoWindow
--     typeface_of(path) -> Typeface из файла
--     drawn() — весь кадр; words(text, x, y, size, tone) — строка текста;
--     colour(name) -> пиксель палитры; chart() — столбики
--     turn() -> no, когда пора выходить
-- program() — вход
-- WIDE, HIGH — окно; CELL — клетка поля; BUDGET, MOVE_GAP, TICK, BARS

use io.file
use core.bytes
use core.group
use core.socket
use core.time
use tarantul.fonts.fonts
use tarantul.wayland.wayland.screen
use tarantul.graphics.graphics
use tarantul.input.gestures
use tarantul.uiengine.draw.atoms
use tarantul.uiengine.draw.shapes
use tarantul.uiengine.draw.typeface
use tarantul.uiengine.themes
use soft.games.snake
use soft.learning.serpent.trainer
use soft.learning.serpent.arena

TITLE = "Змея учится"
WIDE = 1200
HIGH = 620
CELL = 22
BUDGET = 30
MOVE_GAP = 70
TICK = 8
BARS = 40
FIELD_X = 30
FIELD_Y = 100
CHART_X = 780
CHART_Y = 100
CHART_W = 390
CHART_H = 300

Window = Box {
    canvas = graphics.Screen {},
    link = screen.Link {},
    palette = atoms.Palette {},
    reader = gestures.Reader {},
    teacher = trainer.Trainer {},
    show = arena.Arena {},
    clock = 0,
    move_wait = 0,
    shown_best = 0,
    packet = bytes.new(8192),
    hold = bytes.new(4096),
    joined = bytes.new(12288)

    skill open() {
        @host = screen.sized(TITLE, WIDE, HIGH)
        (group.count(host) == 0) {
            out error.NoWindow
        }
        canvas = group.get(host, 0)
        link = group.get(host, 1)
        palette = atoms.with_faces(themes.named("soft", canvas), typeface_of(fonts.REGULAR), typeface_of(fonts.BOLD), typeface_of(fonts.MONO))
        clock = time.now()
        teacher.start(clock)
        show.fresh()
        out drawn()
    }

    skill typeface_of(path) {
        out typeface.from_bytes(file.read_bytes(path))
    }

    skill colour(name) {
        out atoms.tone_color(palette, name, palette.ink)
    }

    skill words(text, x, y, size, tone) {
        @ink = colour(tone)
        @pen = typeface.Brush {
            size = size,
            ink = ink,
            fade = ink
        }
        out typeface.paint(canvas, palette.regular, x, y, text, pen)
    }

    skill chart() {
        words("средний счёт за каждые {trainer.REPORT} партий", CHART_X, CHART_Y - 30, 15, "quiet")
        shapes.shape(canvas, CHART_X, CHART_Y, CHART_W, CHART_H, 12, colour("well"))
        @count = group.count(teacher.history)
        @first = 0
        (count > BARS) {
            first = count - BARS
        }
        @top = 5
        drum (teacher.history) {
            (beat > top) {
                top = beat
            }
        }
        @bar = (CHART_W - 16) / BARS
        @index = 0
        drum (count - first) {
            @value = group.get(teacher.history, first + beat)
            @tall = (CHART_H - 16) * value / top
            shapes.shape(canvas, CHART_X + 8 + index * bar, CHART_Y + CHART_H - 8 - tall, bar - 2, tall + 2, 2, colour("up"))
            index = index + 1
        }
        words("шкала до {top} яблок", CHART_X, CHART_Y + CHART_H + 14, 13, "quiet")
        out none
    }

    skill drawn() {
        shapes.shape(canvas, 0, 0, WIDE, HIGH, 0, colour("ground"))
        @curious = teacher.chance / 10
        @steps = teacher.student.steps
        words("Змея учится", FIELD_X, 24, 26, "ink")
        words("партий {teacher.games} · шагов учёбы {steps} · любопытство {curious} % · рекорд {teacher.best}", FIELD_X, 60, 15, "quiet")
        @width = snake.BOARD_COLUMNS * CELL
        @height = snake.BOARD_ROWS * CELL
        shapes.shape(canvas, FIELD_X - 6, FIELD_Y - 6, width + 12, height + 12, 12, colour("well"))
        @food = show.model.food
        shapes.shape(canvas, FIELD_X + food.x * CELL + 3, FIELD_Y + food.y * CELL + 3, CELL - 6, CELL - 6, (CELL - 6) / 2, colour("watermelon"))
        @index = 0
        drum (show.model.body) {
            @tone = "up"
            (index == 0) {
                tone = "mustard"
            }
            shapes.shape(canvas, FIELD_X + beat.x * CELL + 2, FIELD_Y + beat.y * CELL + 2, CELL - 4, CELL - 4, 6, colour(tone))
            index = index + 1
        }
        words("на поле: {show.model.score} яблок · лучшая партия на поле {shown_best}", FIELD_X, FIELD_Y + height + 20, 17, "ink")
        chart()
        words("глаза сети: опасность прямо, справа, слева · куда едет · где яблоко", CHART_X, CHART_Y + CHART_H + 50, 14, "quiet")
        words("сеть 11 → 48 → 3 · глубокое Q-обучение с нуля на Saltic", CHART_X, CHART_Y + CHART_H + 74, 14, "quiet")
        words("играет наша «Змейка» как есть", CHART_X, CHART_Y + CHART_H + 98, 14, "quiet")
        out screen.present(link)
    }

    skill turn() {
        ((link.way_closed == yes) ○○ (link.way_failed == yes)) {
            out no
        }
        screen.pump(link, packet, hold, joined)
        @drained = reader.drain(link.way_events)
        link.way_events = drained.core
        @now = time.now()
        @spent = now - clock
        (spent < 0) {
            spent = spent + time.DAY_MILLISECONDS
        }
        clock = now
        drum (100000) {
            teacher.step_once()
            @used = time.now() - now
            ((used >= BUDGET) ○○ (used < 0)) {
                leave
            }
        }
        move_wait = move_wait - spent
        (move_wait <= 0) {
            move_wait = MOVE_GAP
            pick {
                (show.over() == yes) {
                    show.fresh()
                }
                {
                    show.move(teacher.greedy(show.state()))
                    (show.model.score > shown_best) {
                        shown_best = show.model.score
                    }
                }
            }
        }
        drawn()
        socket.sleep(TICK)
        out yes
    }
}

program() {
    @window = Window {}
    window.open()
    always {
        (window.turn() == no) {
            leave
        }
    }
    out none
}
