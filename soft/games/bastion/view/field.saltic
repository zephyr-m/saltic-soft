-- field — поле «Бастиона» пикселями: не UIEngine, а свой слой поверх места,
-- которое панель оставила под box с id field. Клетка — квадрат по меньшей
-- стороне, поле по центру места. Дорожка — скруглённые клетки цвета panel,
-- ядро в её конце — кольцо mustard с кругом внутри, башня — круг своего тона
-- с рамкой и точками уровня (до 5; каждые 5 уровней — новый цвет STAGES),
-- враг — круг down (босс крупнее, watermelon) с
-- полоской здоровья над ним, иней — кольцо info у замедленного, вспышка
-- попадания — кольцо ink; над полосой — здоровье числом (LABEL px, шрифт
-- mono). Место врага — realm.at(step) в сотых клетки.
--
-- Field { cell, left, top } — размер клетки и угол поля после place
--     place(realm, x, y, width, height) — клетка и угол под место
--     paint(canvas, palette, realm, x, y, width, height) — всё поле
--     paint_path / paint_core / paint_towers / paint_choice / paint_enemies(canvas,
--         palette, realm) — paint_choice: выбранная башня и свободные места
--     cell_of(realm, x, y) -> [столбец, строка] под точкой экрана или []
--     colour(palette, name) -> пиксель цвета палитры

use core.group
use tarantul.uiengine.draw.atoms
use tarantul.uiengine.draw.shapes
use tarantul.uiengine.draw.typeface
use soft.games.bastion.world

PATH_GAP = 3
LABEL = 11
STAGES = ["line", "accent", "mustard", "watermelon", "info", "up"]
ROUND = 8

Field = Box {
    cell = 40,
    left = 0,
    top = 0

    skill place(realm, x, y, width, height) {
        @across = width / realm.columns
        @down = height / realm.rows
        cell = across
        (down < across) {
            cell = down
        }
        left = x + (width - cell * realm.columns) / 2
        top = y + (height - cell * realm.rows) / 2
        out none
    }

    skill cell_of(realm, x, y) {
        ((x < left) ○○ (y < top)) {
            out []
        }
        @column = (x - left) / cell
        @row = (y - top) / cell
        ((column >= realm.columns) ○○ (row >= realm.rows)) {
            out []
        }
        out [column, row]
    }

    skill paint_choice(canvas, palette, realm) {
        (realm.selected < 0) {
            out none
        }
        @mark = colour(palette, "mustard")
        drum (group.count(realm.spots)) {
            @spot = group.get(realm.spots, beat)
            @column = group.get(spot, 0)
            @row = group.get(spot, 1)
            (realm.tower_at(column, row) < 0) {
                shapes.ring(canvas, left + column * cell + 8, top + row * cell + 8, cell - 16, cell - 16, 8, 2, mark)
            }
        }
        @chosen = group.get(realm.towers, realm.selected)
        out shapes.ring(canvas, left + chosen.column * cell + 2, top + chosen.row * cell + 2, cell - 4, cell - 4, (cell - 4) / 2, 4, mark)
    }

    skill paint(canvas, palette, realm, x, y, width, height) {
        place(realm, x, y, width, height)
        shapes.shape(canvas, x, y, width, height, 12, colour(palette, "well"))
        paint_path(canvas, palette, realm)
        paint_core(canvas, palette, realm)
        paint_towers(canvas, palette, realm)
        paint_choice(canvas, palette, realm)
        paint_enemies(canvas, palette, realm)
        out none
    }

    skill colour(palette, name) {
        out atoms.tone_color(palette, name, palette.ink)
    }

    skill paint_path(canvas, palette, realm) {
        @road = colour(palette, "panel")
        @inner = cell - PATH_GAP * 2
        drum (group.count(realm.path)) {
            @entry = group.get(realm.path, beat)
            @column = group.get(entry, 0)
            @row = group.get(entry, 1)
            shapes.shape(canvas, left + column * cell + PATH_GAP, top + row * cell + PATH_GAP, inner, inner, ROUND, road)
        }
        out none
    }

    skill paint_core(canvas, palette, realm) {
        @last = group.get(realm.path, group.count(realm.path) - 1)
        @x = left + group.get(last, 0) * cell
        @y = top + group.get(last, 1) * cell
        @edge = colour(palette, "mustard")
        shapes.ring(canvas, x - cell / 4, y - cell / 4, cell * 3 / 2, cell * 3 / 2, cell * 3 / 4, 4, edge)
        shapes.shape(canvas, x + cell / 4, y + cell / 4, cell / 2, cell / 2, cell / 4, edge)
        out none
    }

    skill paint_towers(canvas, palette, realm) {
        @rim = colour(palette, "line")
        @size = cell - 10
        @pip = 5
        drum (group.count(realm.towers)) {
            @tower_2 = group.get(realm.towers, beat)
            @x = left + tower_2.column * cell + 5
            @y = top + tower_2.row * cell + 5
            shapes.shape(canvas, x, y, size, size, size / 2, colour(palette, tower_2.tone()))
            shapes.ring(canvas, x, y, size, size, size / 2, 2, rim)
            @dots = (tower_2.level - 1) % 5 + 1
            @stage = colour(palette, group.get(STAGES, ((tower_2.level - 1) / 5) % group.count(STAGES)))
            @span = dots * pip + (dots - 1) * 3
            @start = x + (size - span) / 2
            drum (dots) {
                shapes.shape(canvas, start + beat * (pip + 3), y + size + 1, pip, pip, 2, stage)
            }
        }
        out none
    }

    skill paint_enemies(canvas, palette, realm) {
        @body = colour(palette, "down")
        @boss_body = colour(palette, "watermelon")
        @well = colour(palette, "well")
        @alive = colour(palette, "up")
        @frost = colour(palette, "info")
        @spark = colour(palette, "ink")
        @pen = typeface.Brush {
            size = LABEL,
            ink = spark,
            fade = spark
        }
        drum (group.count(realm.enemies)) {
            @enemy_2 = group.get(realm.enemies, beat)
            @place = realm.at(enemy_2.step)
            @middle_x = left + group.get(place, 0) * cell / world.CELL
            @middle_y = top + group.get(place, 1) * cell / world.CELL
            @size = cell / 2
            @shade = body
            (enemy_2.boss == yes) {
                size = cell * 3 / 4
                shade = boss_body
            }
            @x = middle_x - size / 2
            @y = middle_y - size / 2
            shapes.shape(canvas, x, y, size, size, size / 2, shade)
            (enemy_2.chill > 0) {
                shapes.ring(canvas, x - 3, y - 3, size + 6, size + 6, size / 2 + 3, 2, frost)
            }
            (enemy_2.flash > 0) {
                shapes.ring(canvas, x, y, size, size, size / 2, 2, spark)
            }
            shapes.shape(canvas, x, y - 7, size, 4, 2, well)
            shapes.shape(canvas, x, y - 7, size * enemy_2.health / enemy_2.most, 4, 2, alive)
            @number = "{enemy_2.health}"
            @wide = typeface.measure(palette.mono, number, LABEL, 0)
            typeface.paint(canvas, palette.mono, middle_x - wide / 2, y - 9 - typeface.line_height(palette.mono, LABEL), number, pen)
        }
        out none
    }
}
