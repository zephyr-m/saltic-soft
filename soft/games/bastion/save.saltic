-- save — сохранение «Бастиона» в файл строками «ключ=значение», башни —
-- «tower=код,столбец,строка,уровень». Отлучка — честно: только пассивный доход
-- (realm.income() в секунду × секунды отлучки); волны и награды за убитых
-- без боя не начисляются — волна проходится только настоящим боем. Часы
-- языка — мс от полуночи, поэтому отлучка дольше суток видна как остаток от
-- суток.
--
-- Keeper { path } — где лежит файл
--     store(realm, clock) — записать мир и время clock (time.now)
--     restore(realm, clock) — прочитать, если есть, и начислить отлучку; нет
--         файла — мир остаётся первым запуском
--     number_of(text) -> число из десятичного текста со знаком
--     value_of(line) -> текст после «=»

use io.file
use core.str
use core.num
use core.group
use core.time
use soft.games.bastion.world.tower

Keeper = Box {
    path = ".cache/bastion.save"

    skill store(realm, clock) {
        @lines = [
            "saved={clock}",
            "wave={realm.wave}",
            "gold={realm.gold}",
            "lives={realm.lives}",
            "damage_level={realm.damage_level}",
            "speed_level={realm.speed_level}",
            "income_level={realm.income_level}",
            "earned={realm.earned}",
            "cleared={realm.cleared}",
            "played={realm.played}"
        ]
        drum (realm.towers) {
            @tower_2 = group.get(realm.towers, beat)
            @code = tower_2.code()
            lines = group.add(lines, "tower={code},{tower_2.column},{tower_2.row},{tower_2.level}")
        }
        file.write(path, str.join(lines, "\n"))
        out none
    }

    skill restore(realm, clock) {
        @text = file.read(path) rescue |missing| {
            out none
        }
        @saved = clock
        @towers = []
        @lines_2 = str.lines(text)
        drum (lines_2) {
            @line = group.get(lines_2, beat)
            @value = value_of(line)
            (str.starts_with(line, "saved=") == yes) {
                saved = number_of(value)
            }
            (str.starts_with(line, "wave=") == yes) {
                realm.wave = number_of(value)
            }
            (str.starts_with(line, "gold=") == yes) {
                realm.gold = number_of(value)
            }
            (str.starts_with(line, "lives=") == yes) {
                realm.lives = number_of(value)
            }
            (str.starts_with(line, "damage_level=") == yes) {
                realm.damage_level = number_of(value)
            }
            (str.starts_with(line, "speed_level=") == yes) {
                realm.speed_level = number_of(value)
            }
            (str.starts_with(line, "income_level=") == yes) {
                realm.income_level = number_of(value)
            }
            (str.starts_with(line, "earned=") == yes) {
                realm.earned = number_of(value)
            }
            (str.starts_with(line, "cleared=") == yes) {
                realm.cleared = number_of(value)
            }
            (str.starts_with(line, "played=") == yes) {
                realm.played = number_of(value)
            }
            (str.starts_with(line, "tower=") == yes) {
                @parts = str.split(value, ",")
                towers = group.add(towers, tower.tower_of(number_of(group.get(parts, 0)), number_of(group.get(parts, 1)), number_of(group.get(parts, 2)), number_of(group.get(parts, 3))))
            }
        }
        realm.towers = towers
        realm.first = no
        @away = clock - saved
        (away < 0) {
            away = away + time.DAY_MILLISECONDS
        }
        realm.away_minutes = away / 60000
        realm.away_gold = realm.income() * (away / 1000)
        realm.gold = realm.gold + realm.away_gold
        out none
    }

    skill value_of(line) {
        @parts = str.split(line, "=")
        (group.count(parts) < 2) {
            out ""
        }
        out group.get(parts, 1)
    }

    skill number_of(text) {
        @length = str.bytes(text)
        @negative = str.starts_with(text, "-")
        @first = 0
        (negative == yes) {
            first = 1
        }
        @total = 0
        drum (length - first) {
            total = total * 10 + num.digit_value(str.get(text, beat + first))
        }
        (negative == yes) {
            out -total
        }
        out total
    }
}
