-- shop — лавка «Бастиона»: цены башен (×1,5 за каждую такую же) и улучшений
-- (×1,6 за уровень), покупки по щелчку панели и мастер — работает всегда, игра
-- идёт сама: раз в MASTER_GAP мс берёт то, что даёт больше урона в секунду
-- на монету (новая башня, уровень любой башни, урон, скорость), и копит на
-- это, если не хватает; доход — когда он не дороже четверти кошелька. Мир —
-- realm (world.World); что вышло — realm.news.
--
-- Shop:
--     press(realm, id) — щелчок: buy-archer, buy-cannon, buy-frost, up-damage,
--         up-speed, up-income, up-tower, pause
--     tend(realm, ms) — ход мастера
--     towers_on_sale(realm) -> [Offer] башен; upgrades(realm) -> [Offer] улучшений
--     count_of(realm, code) / tower_price(realm, code) / upgrade_price(base, level)
--     bought_upgrade(realm, price, which) / bought_tower(realm, code)
--     weakest(realm) -> номер самой слабой башни (меньший уровень, первая)
--     tower_up_price(realm) -> цена её следующего уровня; tower_up_title(realm);
--     raised_tower(realm, at) — поднять уровень башни номер at
--     dps_of(realm, tower) -> урон башни в секунду; level_price(tower) -> цена её
--         следующего уровня; spoken(realm) — подписать новость мастером
-- WORTH — множитель «урон в секунду на монету» (целые числа)

use core.group
use soft.games.bastion.world
use soft.games.bastion.world.tower
use soft.games.bastion.shop.offer

MASTER_GAP = 1000
WORTH = 1000000

Shop = Box {
    skill tend(realm, ms) {
        realm.master_wait = realm.master_wait - ms
        (realm.master_wait > 0) {
            out none
        }
        realm.master_wait = MASTER_GAP
        @income_price = upgrade_price(300, realm.income_level)
        ((income_price * 4) <= realm.gold) {
            press(realm, "up-income")
            out spoken(realm)
        }
        @best = ""
        @target = -1
        @best_price = 0
        @best_worth = -1
        @free = (group.count(realm.free_spot()) > 0)
        @ids = ["buy-archer", "buy-cannon", "buy-frost"]
        (free == yes) {
            drum (3) {
                @sample = tower.tower_of(beat, 0, 0, 1)
                @price = tower_price(realm, beat)
                @worth = dps_of(realm, sample) * WORTH / price
                (worth > best_worth) {
                    best = group.get(ids, beat)
                    best_price = price
                    best_worth = worth
                }
            }
        }
        drum (realm.towers) {
            @standing = group.get(realm.towers, beat)
            @price = level_price(standing)
            @worth = dps_of(realm, standing) / standing.level * WORTH / price
            (worth > best_worth) {
                best = "up-tower"
                target = beat
                best_price = price
                best_worth = worth
            }
        }
        @fire = realm.firepower()
        @damage_price = upgrade_price(200, realm.damage_level)
        @damage_worth = fire * world.DAMAGE_STEP / (100 + realm.damage_level * world.DAMAGE_STEP) * WORTH / damage_price
        (damage_worth > best_worth) {
            best = "up-damage"
            best_price = damage_price
            best_worth = damage_worth
        }
        @speed_price = upgrade_price(150, realm.speed_level)
        @speed_worth = fire * world.SPEED_STEP / (100 + realm.speed_level * world.SPEED_STEP) * WORTH / speed_price
        (speed_worth > best_worth) {
            best = "up-speed"
            best_price = speed_price
            best_worth = speed_worth
        }
        ((best_worth < 0) ○○ (realm.gold < best_price)) {
            out none
        }
        pick {
            (best == "up-tower") {
                raised_tower(realm, target)
            }
            {
                press(realm, best)
            }
        }
        out spoken(realm)
    }

    skill spoken(realm) {
        @said = realm.news
        realm.news = "мастер — {said}"
        out none
    }

    skill dps_of(realm, shooter) {
        @haste = 100 + realm.speed_level * world.SPEED_STEP
        out realm.damage_of(shooter) * 1000 * haste / 100 / shooter.pause()
    }

    skill level_price(standing) {
        out upgrade_price(group.get([100, 400, 800], standing.code()), standing.level)
    }

    skill count_of(realm, code) {
        @total = 0
        drum (realm.towers) {
            @tower_2 = group.get(realm.towers, beat)
            (tower_2.code() == code) {
                total = total + 1
            }
        }
        out total
    }

    skill tower_price(realm, code) {
        @price = group.get([100, 400, 800], code)
        drum (count_of(realm, code)) {
            price = price * 3 / 2
        }
        out price
    }

    skill upgrade_price(base, level) {
        @price = base
        drum (level) {
            price = price * 8 / 5
        }
        out price
    }

    skill towers_on_sale(realm) {
        @offers = []
        @ids = ["buy-archer", "buy-cannon", "buy-frost"]
        drum (3) {
            @sample = tower.tower_of(beat, 0, 0, 1)
            offers = group.add(offers, offer.Offer {
                id = group.get(ids, beat),
                icon = sample.icon(),
                title = sample.title(),
                count = count_of(realm, beat),
                power = realm.damage_of(sample),
                price = tower_price(realm, beat)
            })
        }
        out offers
    }

    skill upgrades(realm) {
        @percent = world.DAMAGE_STEP * realm.damage_level
        @faster = world.SPEED_STEP * realm.speed_level
        @flow = realm.income()
        @offers = [
            offer.Offer {
                id = "up-damage",
                title = "урон +{percent}%",
                price = upgrade_price(200, realm.damage_level)
            },
            offer.Offer {
                id = "up-speed",
                title = "скорость +{faster}%",
                price = upgrade_price(150, realm.speed_level)
            },
            offer.Offer {
                id = "up-income",
                title = "доход {flow}/с",
                price = upgrade_price(300, realm.income_level)
            }
        ]
        (group.count(realm.towers) == 0) {
            out offers
        }
        out group.add(offers, offer.Offer {
            id = "up-tower",
            title = tower_up_title(realm),
            price = tower_up_price(realm)
        })
    }

    skill weakest(realm) {
        @best = 0
        drum (realm.towers) {
            @here = group.get(realm.towers, beat)
            @leader = group.get(realm.towers, best)
            (here.level < leader.level) {
                best = beat
            }
        }
        out best
    }

    skill tower_up_price(realm) {
        (group.count(realm.towers) == 0) {
            out 0
        }
        out level_price(group.get(realm.towers, weakest(realm)))
    }

    skill tower_up_title(realm) {
        (group.count(realm.towers) == 0) {
            out "башня: пока нет"
        }
        @chosen = group.get(realm.towers, weakest(realm))
        @name = chosen.title()
        @next = chosen.level + 1
        out "{name} → ур. {next}"
    }

    skill raised_tower(realm, at) {
        @chosen = group.get(realm.towers, at)
        @price = level_price(chosen)
        (realm.gold < price) {
            realm.news = "мало золота: уровень башни стоит {price}"
            out none
        }
        chosen.level = chosen.level + 1
        realm.towers = group.replaced(realm.towers, at, chosen)
        realm.gold = realm.gold - price
        @name = chosen.title()
        @level = chosen.level
        realm.news = "{name} подняла уровень до {level} за {price}"
        out none
    }

    skill press(realm, id) {
        (id == "pause") {
            realm.paused = (realm.paused == no)
            realm.news = "пауза"
            (realm.paused == no) {
                realm.news = "дальше"
            }
            out none
        }
        (id == "up-damage") {
            out bought_upgrade(realm, upgrade_price(200, realm.damage_level), "damage")
        }
        (id == "up-speed") {
            out bought_upgrade(realm, upgrade_price(150, realm.speed_level), "speed")
        }
        (id == "up-income") {
            out bought_upgrade(realm, upgrade_price(300, realm.income_level), "income")
        }
        (id == "up-tower") {
            out raised_tower(realm, weakest(realm))
        }
        @ids = ["buy-archer", "buy-cannon", "buy-frost"]
        drum (3) {
            (group.get(ids, beat) == id) {
                out bought_tower(realm, beat)
            }
        }
        out none
    }

    skill bought_upgrade(realm, price, which) {
        (realm.gold < price) {
            realm.news = "мало золота: улучшение стоит {price}"
            out none
        }
        realm.gold = realm.gold - price
        realm.news = "улучшено за {price}"
        (which == "damage") {
            realm.damage_level = realm.damage_level + 1
        }
        (which == "speed") {
            realm.speed_level = realm.speed_level + 1
        }
        (which == "income") {
            realm.income_level = realm.income_level + 1
        }
        out none
    }

    skill bought_tower(realm, code) {
        @price = tower_price(realm, code)
        (realm.gold < price) {
            realm.news = "мало золота: башня стоит {price}"
            out none
        }
        @spot = realm.free_spot()
        (group.count(spot) == 0) {
            realm.news = "мест под башни больше нет"
            out none
        }
        realm.gold = realm.gold - price
        @built = tower.tower_of(code, group.get(spot, 0), group.get(spot, 1), 1)
        realm.towers = group.add(realm.towers, built)
        @name = built.title()
        realm.news = "поставлен: {name} за {price}"
        out none
    }
}
