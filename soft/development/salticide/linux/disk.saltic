-- disk — файлы проекта для SalticIDE в Linux: дерево от папки, где запущена
-- IDE (ярлык ставит её в корень проекта), строками project.Row — папки
-- сверху, потом файлы, по алфавиту байтов; скрытые (с точки) не видны.
-- Раскрытые папки — opened, щелчок переключает. Файл читается текстом, если
-- его окончание из TEXTS; иначе и при ошибке чтения — одна строка с причиной.
-- Строки — str.lines, точно как в файле, с пустыми: сохранение возвращает
-- файл байт в байт. Длинный файл — первые LIMIT строк и строка, сколько не показано; такой,
-- как и не текст, — только читать (whole no), иначе сохранение отрезало бы
-- хвост.
--
-- Text { lines, whole } — строки файла и прочитан ли он целиком как текст
-- Disk { opened } — пути раскрытых папок
-- rows() -> [project.Row] — дерево сверху вниз
-- toggle(path) — раскрыть или свернуть папку
-- read(path) -> Text
-- write(path, lines) — записать строки, склеив через «\n»
-- project_places() -> папки для нового проекта: корень «.», папки корня и их папки
--     (скрытые не видны); folders_in(place) -> папки внутри place по алфавиту
-- Внутри: walk(folder, depth) -> строки поддерева; folder(path) -> yes, если
--     папка; sorted(names) — по алфавиту байтов; before(a, b) -> yes/no

use io.file
use core.str
use core.group
use soft.development.salticide.components.project

TEXTS = [".saltic", ".md", ".txt", ".json", ".jtml", ".js", ".html", ".css", ".py", ".nix", ".toml", ".yml", ".sh", "justfile", ".gitignore", ".lock", ".log", "LICENSE", "LICENSE.ru", "NOTICE", "VERSION"]
LIMIT = 4000
HIDDEN = 46

Text = Box {
    lines = [],
    whole = no
}

skill before(left, right) {
    @count = str.bytes(left)
    (str.bytes(right) < count) { count = str.bytes(right) }
    drum (count) {
        @a = str.byte(left, beat)
        @b = str.byte(right, beat)
        (a < b) { out yes }
        (a > b) { out no }
    }
    out str.bytes(left) < str.bytes(right)
}

skill sorted(names) {
    @made = []
    drum (group.count(names)) {
        @item = group.get(names, beat)
        @at = 0
        drum (group.count(made)) {
            (before(group.get(made, beat), item) == yes) { at = beat + 1 }
        }
        made = group.concat(group.add(group.slice(made, 0, at), item), group.slice(made, at, group.count(made)))
    }
    out made
}

skill folder(path) {
    file.list(path) rescue |err| { out no }
    out yes
}

Disk = Box {
    opened = []

    skill walk(place, depth) {
        @names = file.list(place) rescue |err| { out [] }
        @folders = []
        @files = []
        @name_2s = sorted(names)
        drum (group.count(name_2s)) {
            @name_2 = group.get(name_2s, beat)
            ((str.byte(name_2, 0) == HIDDEN) == no) {
                @path = name_2
                ((place == ".") == no) { path = "{place}/{name_2}" }
                pick {
                    (folder(path) == yes) { folders = group.add(folders, path) }
                    { files = group.add(files, path) }
                }
            }
        }
        @made = []
        drum (group.count(folders)) {
            @folder_2 = group.get(folders, beat)
            @path = folder_2
            @open = group.contains(opened, path)
            @parts = str.split(path, "/")
            made = group.add(made, project.Row { kind = project.FOLDER, name = group.get(parts, group.count(parts) - 1), path = path, depth = depth, open = open })
            (open == yes) { made = group.concat(made, walk(path, depth + 1)) }
        }
        drum (group.count(files)) {
            @file_2 = group.get(files, beat)
            @parts = str.split(file_2, "/")
            made = group.add(made, project.Row { kind = project.FILE, name = group.get(parts, group.count(parts) - 1), path = file_2, depth = depth })
        }
        out made
    }

    skill folders_in(place) {
        @names = file.list(place) rescue |err| { out [] }
        @found = []
        @names_2 = sorted(names)
        drum (group.count(names_2)) {
            @name = group.get(names_2, beat)
            ((str.byte(name, 0) == HIDDEN) == no) {
                @path = name
                ((place == ".") == no) { path = "{place}/{name}" }
                (folder(path) == yes) { found = group.add(found, path) }
            }
        }
        out found
    }

    skill project_places() {
        @found = ["."]
        @entries = folders_in(".")
        drum (group.count(entries)) {
            @entry = group.get(entries, beat)
            found = group.add(found, entry)
            found = group.concat(found, folders_in(entry))
        }
        out found
    }

    skill rows() {
        out walk(".", 0)
    }

    skill toggle(path) {
        (group.contains(opened, path) == no) {
            opened = group.add(opened, path)
            out none
        }
        @left = []
        drum (group.count(opened)) {
            @entry = group.get(opened, beat)
            ((entry == path) == no) { left = group.add(left, entry) }
        }
        opened = left
        out none
    }

    skill read(path) {
        @known = no
        drum (group.count(TEXTS)) {
            @text_2 = group.get(TEXTS, beat)
            (str.ends_with(path, text_2) == yes) { known = yes }
        }
        (known == no) {
            out Text {
                lines = ["-- {path}: не текст — IDE показывает файлы с окончаниями из disk.TEXTS"]
            }
        }
        @text = file.read(path) rescue |err| {
            out Text {
                lines = ["-- {path}: не прочитан ({err})"]
            }
        }
        @lines = str.lines(text)
        @count = group.count(lines)
        (count <= LIMIT) {
            out Text {
                lines = lines,
                whole = yes
            }
        }
        @rest = count - LIMIT
        out Text {
            lines = group.add(group.slice(lines, 0, LIMIT), "-- ещё {rest} строк не показано (disk.LIMIT)")
        }
    }

    skill write(path, lines) {
        out file.write(path, str.join(lines, "\n"))
    }
}
