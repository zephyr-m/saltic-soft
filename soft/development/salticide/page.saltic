-- page — страница SalticIDE, уровень 5: Box Page ставит компоненты
-- salticide/components по местам — заголовок (head) сверху, дерево (tree) и
-- редактор (pane) в ряд или режим «сборка» (builder), а пока открыт мастер
-- нового проекта (maker) — он; полоса режимов (foot) внизу, меню (menus) в
-- шапке и поверх; тема — светлая 1 с сайта. Открытые
-- файлы — docs. Диск — у хозяина окна (salticide/linux/disk): дерево, текст,
-- сохранение (saved). Сборка, запуск и создание проекта — пока макет: говорят
-- в полосе, что подключатся после ОК автора.
--
-- Doc { path, lines, first, light, column, dirty, writable } — файл
-- Page { head, tree, pane, foot, menus, builder, maker, docs, warned, wanted }
--     — warned — о чьих правках предупредили; wanted — new / save / quit для
--     хозяина (new — он открывает мастер со своими папками: maker.launch)
-- act(name) — действие меню: new, save, close, quit, build, run; offer(places)
--     — открыть мастер нового проекта с папками хозяина
-- files(rows) — строки дерева проекта (project.Row)
-- open(path, lines, writable) — открыть файл (уже открыт — переключиться);
--     writable no — только читать (файл не целиком или не текст)
-- close(path) — закрыть файл; правлен и не сохранён — сначала предупредить в
--     полосе, закрыть со второго раза; был активным — активен последний, не
--     осталось ни одного — приветствие
-- show(path) — сделать открытый файл активным: редактор, вкладки, заголовок,
--     место в дереве, место курсора; reach(path, lines, writable, line,
--     column) — открыть и поставить курсор (переход к определению)
-- typed(text) — набор (в мастере — имя проекта, Enter — дальше); press(name) ->
--     yes, если клавиша что-то сделала (Esc — меню, мастер; F5 — собрать);
--     saved() — хозяин записал; told(text) — в полосу; unsaved() -> yes/no
-- opened(lines) -> Page — образец lines (code.PATH), только читать
-- jtml() -> текст страницы: слева дерево, в середине код, справа цель сборки
--     (builder.tools — места и «собрать»), в режиме «сборка» — журнал
-- fit(height) — экран высотой height: строк кода — сколько влезет между
--     заголовком, вкладками и полосой (CHROME точек на них), дереву — всё
--     между заголовком и полосой (FRAME точек на них)
-- wheel(steps, x) — колесо: левее project.WIDTH — дерево, иначе код;
--     click(hit, x, y) -> yes, если щелчок что-то поменял (hit — jtml.hit):
--     меню, режим, кнопки сборки, строка кода, полоса прокрутки, вкладка, крестик
-- Внутри: dirty_of(path); edited() — после правки; named(text) — набор в
--     мастере; made() — «создать» мастера; guided(id) -> yes, если щелчок его

use core.str
use core.group
use tarantul.uiengine.jtml.calls
use soft.development.salticide.code
use soft.development.salticide.syntax
use soft.development.salticide.components.title
use soft.development.salticide.components.project
use soft.development.salticide.components.editor
use soft.development.salticide.components.status
use soft.development.salticide.components.menu
use soft.development.salticide.components.builds
use soft.development.salticide.components.wizard


CHROME = 147
FRAME = 90


Doc = Box {
    path = "",
    lines = [],
    first = 1,
    light = 1,
    column = 0,
    dirty = no,
    writable = yes
}

Page = Box {
    head = title.TitleBar {},
    tree = project.Project {},
    pane = editor.Editor {},
    foot = status.StatusBar {},
    menus = menu.Menu {},
    builder = builds.Builds {},
    maker = wizard.Wizard {},
    docs = [],
    warned = "",
    wanted = ""

    skill act(name) {
        (name == "close") {
            (pane.active == "") {
                out none
            }
            out close(pane.active)
        }
        (name == "build") {
            foot.mode = status.BUILD
            foot.mark = builder.demo(pane.active)
            out told("демо-сборка: настоящую подключу после твоего ОК")
        }
        (name == "run") {
            foot.mode = status.BUILD
            out told("макет: запуск подключу после твоего ОК")
        }
        wanted = name
        out none
    }

    skill offer(places) {
        out maker.launch(places)
    }

    skill made() {
        maker.open = no
        (maker.draft == "") {
            out told("у проекта нет имени — не создан")
        }
        @place = maker.folder()
        out told("макет: создам {place}/ ({maker.kind}) после твоего ОК")
    }

    skill named(text) {
        (text == "\n") {
            (maker.step == 1) {
                maker.step = 2
                out none
            }
            out made()
        }
        (maker.step == 1) {
            out none
        }
        (text == "⌫") {
            @letters = str.letters(maker.draft)
            (group.count(letters) == 0) {
                out none
            }
            maker.draft = str.join(group.slice(letters, 0, group.count(letters) - 1), "")
            out none
        }
        maker.draft = str.concat(maker.draft, text)
        out none
    }

    skill guided(id) {
        (str.starts_with(id, wizard.KIND) == yes) {
            maker.kind = str.slice(id, str.bytes(wizard.KIND), str.bytes(id))
            out yes
        }
        (id == wizard.NEXT) {
            maker.step = 2
            out yes
        }
        (id == wizard.BACK) {
            maker.step = 1
            out yes
        }
        (id == wizard.CANCEL) {
            maker.open = no
            out yes
        }
        (id == wizard.PLACE) {
            maker.place = (maker.place + 1) % group.count(maker.places)
            out yes
        }
        (id == wizard.CREATE) {
            made()
            out yes
        }
        out no
    }

    skill files(rows) {
        tree.rows = rows
        out tree.scroll(0)
    }

    skill open(path, lines, writable) {
        @known = no
        drum (group.count(docs)) {
            @doc = group.get(docs, beat)
            (doc.path == path) {
                known = yes
            }
        }
        (known == no) {
            @fresh = Doc {
                path = path,
                lines = lines,
                writable = writable
            }
            docs = group.add(docs, fresh)
        }
        out show(path)
    }

    skill dirty_of(path) {
        (path == pane.active) {
            out pane.dirty
        }
        drum (group.count(docs)) {
            @doc = group.get(docs, beat)
            (doc.path == path) {
                out doc.dirty
            }
        }
        out no
    }

    skill close(path) {
        (dirty_of(path) == yes) {
            ((warned == path) == no) {
                warned = path
                foot.note = "{path} не сохранён: Ctrl+S — сохранить, × ещё раз — закрыть без сохранения"
                out none
            }
        }
        warned = ""
        foot.note = ""
        @left = []
        @paths = []
        drum (group.count(docs)) {
            @doc = group.get(docs, beat)
            ((doc.path == path) == no) {
                left = group.add(left, doc)
                paths = group.add(paths, doc.path)
            }
        }
        docs = left
        pane.tabs = paths
        ((pane.active == path) == no) {
            out none
        }
        (group.count(docs) > 0) {
            out show(group.get(paths, group.count(paths) - 1))
        }
        pane.lines = []
        pane.info = syntax.Info {}
        pane.active = ""
        pane.first = 1
        pane.light = 1
        pane.column = 0
        pane.dirty = no
        tree.current = ""
        head.path = ""
        foot.place = "1:1"
        out tree.scroll(0)
    }

    skill show(path) {
        @made = []
        @paths = []
        @chosen = Doc {}
        drum (group.count(docs)) {
            @doc = group.get(docs, beat)
            (doc.path == pane.active) {
                doc.lines = pane.lines
                doc.first = pane.first
                doc.light = pane.light
                doc.column = pane.column
                doc.dirty = pane.dirty
            }
            (doc.path == path) {
                chosen = doc
            }
            made = group.add(made, doc)
            paths = group.add(paths, doc.path)
        }
        docs = made
        pane.lines = chosen.lines
        pane.info = syntax.scan(chosen.lines)
        pane.first = chosen.first
        pane.light = chosen.light
        pane.column = chosen.column
        pane.dirty = chosen.dirty
        pane.writable = chosen.writable
        pane.tabs = paths
        pane.active = path
        tree.current = path
        head.path = path
        foot.place = pane.place()
        foot.note = ""
        (chosen.writable == no) {
            foot.note = "только чтение: файл не текст или открыт не целиком"
        }
        out none
    }

    skill reach(path, lines, writable, line, column) {
        open(path, lines, writable)
        pane.light = line
        pane.column = column
        pane.follow()
        foot.place = pane.place()
        out none
    }

    skill edited() {
        warned = ""
        foot.place = pane.place()
        out none
    }

    skill typed(text) {
        (maker.open == yes) {
            out named(text)
        }
        (foot.mode == status.BUILD) {
            out none
        }
        (pane.active == "") {
            out none
        }
        pane.typed(text)
        out edited()
    }

    skill press(name) {
        (name == "escape") {
            ((menus.open == "") == no) {
                menus.open = ""
                out yes
            }
            (maker.open == yes) {
                maker.open = no
                out yes
            }
            out no
        }
        (name == "f5") {
            act("build")
            out yes
        }
        (foot.mode == status.BUILD) {
            out no
        }
        (pane.active == "") {
            out no
        }
        (pane.press(name) == no) {
            out no
        }
        edited()
        out yes
    }

    skill saved() {
        pane.dirty = no
        foot.note = "сохранено: {pane.active}"
        out none
    }

    skill told(text) {
        foot.note = text
        out none
    }

    skill unsaved() {
        (pane.dirty == yes) {
            out yes
        }
        drum (group.count(docs)) {
            @doc = group.get(docs, beat)
            (doc.dirty == yes) {
                out yes
            }
        }
        out no
    }

    skill fit(height) {
        pane.shown = (height - CHROME) / editor.ROW
        tree.fit(height - FRAME)
        out pane.scroll(0)
    }

    skill wheel(steps, x) {
        (foot.mode == status.BUILD) {
            out none
        }
        (x < project.WIDTH) {
            out tree.scroll(steps)
        }
        out pane.scroll(steps)
    }

    skill click(hit, x, y) {
        @was = menus.open
        ((was == "") == no) {
            @chosen = menus.picked(x, y)
            ((chosen == "") == no) {
                act(chosen)
                out yes
            }
            (str.starts_with(hit.id, menu.NAME) == no) {
                out yes
            }
        }
        (str.starts_with(hit.id, menu.NAME) == yes) {
            @name = str.slice(hit.id, str.bytes(menu.NAME), str.bytes(hit.id))
            ((name == was) == no) {
                menus.unfold(name, hit.x)
            }
            out yes
        }
        (maker.open == yes) {
            out guided(hit.id)
        }
        (str.starts_with(hit.id, status.MODE) == yes) {
            foot.mode = str.slice(hit.id, str.bytes(status.MODE), str.bytes(hit.id))
            out yes
        }
        (hit.id == builds.BUILD) {
            act("build")
            out yes
        }
        (str.starts_with(hit.id, builds.AIM) == yes) {
            builder.target = str.slice(hit.id, str.bytes(builds.AIM), str.bytes(hit.id))
            out yes
        }
        (hit.id == builds.RUN) {
            act("run")
            out yes
        }
        (str.starts_with(hit.id, editor.CLOSE) == yes) {
            close(str.slice(hit.id, str.bytes(editor.CLOSE), str.bytes(hit.id)))
            out yes
        }
        (str.starts_with(hit.id, editor.TAB) == yes) {
            show(str.slice(hit.id, str.bytes(editor.TAB), str.bytes(hit.id)))
            out yes
        }
        (hit.id == editor.TRACK) {
            pane.jump(y - hit.y, hit.height)
            out yes
        }
        (pane.point(hit.id, x - hit.x) == no) {
            out no
        }
        foot.place = pane.place()
        out yes
    }

    skill jtml() {
        @line = calls.call("bar", [["height", "1"], ["tone", calls.quoted("line")]])
        @upright = calls.call("bar", [["width", "1"], ["tone", calls.quoted("line")]])
        @middle = calls.join([tree.jtml(), upright, pane.jtml(), upright, builder.tools()])
        @body = "\{\"box\": \{\"flow\": \"row\", \"grow\": 1, \"gap\": 0, \"children\": [{middle}]\}\}"
        (foot.mode == status.BUILD) {
            body = builder.jtml()
        }
        (maker.open == yes) {
            body = maker.jtml()
        }
        @parts = [head.titled(menus.titles()), line, body, line, foot.jtml()]
        ((menus.open == "") == no) {
            parts = group.add(parts, menus.drop())
        }
        @inside = calls.join(parts)
        out "\{\"box\": \{\"fill\": \"ground\", \"gap\": 0, \"children\": [{inside}]\}\}"
    }
}

skill opened(lines) {
    @view = Page {
        head = title.TitleBar {
            path = code.PATH
        }
    }
    view.open(code.PATH, lines, no)
    view.told("образец с сайта — только чтение")
    out view
}
