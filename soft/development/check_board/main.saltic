-- check_board — «Проверка всего»: пульт global-check в окне Wayland, вид
-- docs/site/private/CHECK-LOOK.html на атомах и жителях UIEngine (решение
-- автора 28.11.2026: сам запускает). При открытии показывает прошлый прогон по
-- журналам ../saltic/.cache/build/workbench; «▶ быстрая» запускает just quick,
-- «глобальная» — just global-check в ../saltic (SALTIC_PLAIN=1 — без своего окна и чека),
-- дальше журналы перечитываются раз в секунду, крутилки вертятся. Справа —
-- журнал: щелчок по ветке открывает её вкладку, вкладка just — общий вывод;
-- колесо листает ветки поля. Число проверок набегает плавно, как счётчик
-- света; проверка идёт с низшим приоритетом. «×» окна — выход.
--
-- Window { canvas, link, palette, runtime, checks, reader, packet, hold,
--     joined, first, picked, tick, read_at, spun_at, shown, target, pace,
--     counted_at, log, voice, spots_before, parts, whole, cost, frames, fps_at, log_asked, log_pending, heard, went, ended } — log — журнал справа (page.Log); voice —
--     звуки (sound), heard — что пульт уже озвучил [клеток ok, провалов,
--     шагов подготовки], went / ended — взлёт и итог уже прозвучали; shown / target — проверки на счётчике и на деле в тысячных,
--     pace — тысячных за мс; open() — окно, шрифты, доска,
--     первый кадр; NoWindow; step() -> no, когда окно закрыто
-- program() — вход
-- Внутри: face(path) -> Typeface из файла; build() — пересобрать кадр;
--     cost — мс последнего кадра, по стадиям — в log.stages и в STAGES;
--     кадр рисует только изменившееся (regions: spots_before — узлы прошлого
--     кадра, parts — куски, whole — весь экран); show() — показать куски;
--     пока что-то идёт, кадр рисуется на каждом обороте, без пауз; frames / fps_at — кадров в текущей секунде (график к/с); log_asked / log_pending — хвост журнала в фоне;
--     click(id) — щелчок по цели; listen() — озвучить новое с прошлого
--     чтения (только свой прогон); fresh_log() / ask_log() / take_log() — хвост журнала вкладки по фильтру в
--     фоне, окно его не ждёт; count() — новая цель счётчика и его
--     скорость; glide(ms) -> yes, если счётчик сдвинулся (плавно: своя скорость
--     плюс догон отставания, без скачков); number(text) -> число из цифр; live() -> yes,
--     пока что-то идёт

use core.str
use core.time
use core.bytes
use core.group
use core.socket
use core.process
use io.file
use tarantul.icons.icons
use tarantul.fonts.ttf
use tarantul.fonts.fonts
use tarantul.input.gestures
use tarantul.wayland.wayland.screen
use tarantul.graphics.graphics
use tarantul.uiengine.jtml
use tarantul.uiengine.jtml.read
use tarantul.uiengine.draw.atoms
use tarantul.uiengine.draw.typeface
use tarantul.uiengine.themes
use soft.development.check_board.board
use soft.development.check_board.page
use soft.development.check_board.sound
use tarantul.uiengine.draw.regions

TITLE = "Проверка всего"
WIDE = 1920
HIGH = 1020
TURN = 800
READ = 1000
STAGES = ".cache/check-board/frame-stages.txt"
TAIL_ANSWER = "../saltic/.cache/build/workbench/board-tail.txt"
DAY = 86400000

Window = Box {
    canvas = graphics.Screen {},
    link = screen.Link {},
    palette = atoms.Palette {},
    runtime = jtml.Runtime {},
    checks = board.Board {},
    reader = gestures.Reader {},
    packet = bytes.new(8192),
    hold = bytes.new(4096),
    joined = bytes.new(12288),
    first = 0,
    picked = [],
    tick = 0,
    read_at = 0,
    spun_at = 0,
    shown = 0,
    target = 0,
    pace = 0,
    counted_at = 0,
    log = page.Log {},
    voice = sound.Sound {},
    spots_before = [],
    parts = [],
    whole = yes,
    cost = 0,
    frames = 0,
    fps_at = 0,
    log_asked = 0,
    log_pending = no,
    heard = [0, 0, 0],
    went = no,
    ended = no

    skill face(path) {
        out typeface.from_bytes(file.read_bytes(path))
    }

    skill open() {
        voice.prepare()
        @host = screen.sized(TITLE, WIDE, HIGH)
        (group.count(host) == 0) { out error.NoWindow }
        canvas = group.get(host, 0)
        link = group.get(host, 1)
        @sheet = file.read_bytes(icons.SHEET)
        @faced = atoms.with_faces(themes.named("soft", canvas), face(fonts.REGULAR), face(fonts.BOLD), face(fonts.MONO))
        palette = atoms.with_icons(faced, icons.open(ttf.from_bytes(sheet), bytes.count(sheet)))
        checks.lay("../saltic")
        checks.ask()
        counted_at = time.now()
        spun_at = time.now()
        count()
        ask_log()
        build()
        out show()
    }

    skill build() {
        @began = time.now()
        @source = page.jtml(checks, first, picked, tick, shown / 1000, log, voice.on)
        @written = time.now()
        @parsed = read.page(source)
        @read_at_ms = time.now()
        @tree = atoms.fitted(parsed, no, palette)
        @fitted_at = time.now()
        runtime = jtml.mount(canvas, tree)
        @mounted_at = time.now()
        @now_spots = regions.spots(runtime)
        parts = [[0, 0, canvas.width, canvas.height]]
        (whole == no) { parts = regions.changes(spots_before, now_spots, canvas.width, canvas.height) }
        spots_before = now_spots
        @compared_at = time.now()
        (whole == yes) { atoms.draw(canvas, runtime, palette) }
        (whole == no) { regions.redraw(canvas, runtime, palette, parts) }
        whole = no
        @drawn_at = time.now()
        cost = gone(began)
        log.cost = cost
        log.stages = [written - began, read_at_ms - written, fitted_at - read_at_ms, mounted_at - fitted_at, compared_at - mounted_at, drawn_at - compared_at]
        @painted = 0
        drum (parts) { painted = painted + group.get(beat, 2) * group.get(beat, 3) }
        log.painted = (painted * 100) / (canvas.width * canvas.height)
        @size = str.bytes(source)
        file.write(STAGES, "текст {log.stages}\nбайт JTML {size}\n") rescue |err| { none }
        frames = frames + 1
        out none
    }

    skill show() {
        (group.count(parts) == 0) { out none }
        out screen.present_parts(link, parts)
    }

    skill number(text) {
        @value = 0
        drum (str.bytes(text)) { value = value * 10 + str.byte(text, beat) - 48 }
        out value
    }

    skill click(id) {
        @asked = ""
        (id == page.QUICK) { asked = board.QUICK }
        (id == page.AGAIN) { asked = board.GLOBAL }
        (str.bytes(asked) > 0) {
            checks.start(asked)
            heard = [0, 0, 0]
            went = no
            ended = no
            shown = 0
            target = 0
            pace = 0
            picked = []
            first = 0
            out yes
        }
        (id == page.CLOSE) {
            picked = []
            fresh_log()
            out yes
        }
        (id == page.SOUND) {
            voice.toggle()
            out yes
        }
        (str.starts_with(id, "filter-") == yes) {
            log.filter = id
            fresh_log()
            out yes
        }
        (str.starts_with(id, page.CELL) == no) { out no }
        @pieces = str.split(str.slice(id, str.bytes(page.CELL), str.bytes(id)), "-")
        @head = group.get(pieces, 0)
        (head == "p") { out no }
        picked = [number(head)]
        fresh_log()
        out yes
    }

    skill gone(moment) {
        @spent = time.now() - moment
        (spent < 0) { spent = spent + DAY }
        out spent
    }

    skill fresh_log() {
        log_pending = no
        out ask_log()
    }

    skill ask_log() {
        (log_pending == yes) { out none }
        @path = checks.driver.log
        (group.count(picked) > 0) {
            @branch = group.get(checks.field, group.get(picked, 0))
            path = branch.log
        }
        @sifted = "grep -av '\\[ok\\]' \"$1\""
        (log.filter == page.FILTER_FAILS) { sifted = "grep -av '\\[ok\\]' \"$1\" | grep -aE 'FAIL\\]|✗|^ошибка:'" }
        (log.filter == page.FILTER_ALL) { sifted = "cat \"$1\"" }
        log_asked = time.now()
        @script = "( echo \"seq $2\"; if [ -e \"$1\" ]; then wc -c < \"$1\"; {sifted} | grep -av '^[[:space:]]*$' | tail -n {page.LOG_LINES}; fi ) > \"$0.part\" && mv -f \"$0.part\" \"$0\" &"
        process.run(["bash", "-c", script, TAIL_ANSWER, path, "{log_asked}"], "", []) rescue |err| { out none }
        log_pending = yes
        out none
    }

    skill take_log() {
        (log_pending == no) { out no }
        @text = file.read(TAIL_ANSWER) rescue |err| { out no }
        @lines = str.lines(text)
        (group.count(lines) == 0) { out no }
        ((group.get(lines, 0) == "seq {log_asked}") == no) { out no }
        log_pending = no
        log.lines = []
        log.bytes = 0
        (group.count(lines) < 2) { out yes }
        log.bytes = number(group.get(lines, 1))
        log.lines = group.without(group.slice(lines, 2, group.count(lines)), "")
        out yes
    }

    skill listen() {
        (checks.launched == no) { out none }
        @tally = checks.counts()
        @prepared = 0
        drum (checks.prep) {
            (checks.state(beat) == "ok") { prepared = prepared + 1 }
        }
        @launched_now = no
        drum (checks.field) {
            ((checks.state(beat) == "wait") == no) { launched_now = yes }
        }
        @finished_now = checks.finished()
        @was_ok = group.get(heard, 0)
        @was_bad = group.get(heard, 1)
        @was_prep = group.get(heard, 2)
        (prepared > was_prep) { voice.play("prep") }
        (launched_now == yes) {
            (went == no) {
                (group.count(checks.prep) > 0) { voice.play("launch") }
            }
        }
        @fresh = group.get(tally, 0) - was_ok - (prepared - was_prep)
        (fresh > 0) { voice.pings(fresh) }
        (group.get(tally, 1) > was_bad) { voice.play("fail") }
        (finished_now == yes) {
            (ended == no) {
                @made = checks.checks()
                @verdict = "win"
                (group.get(tally, 1) > 0) { verdict = "lose" }
                (group.get(made, 1) > 0) { verdict = "lose" }
                voice.play(verdict)
            }
        }
        heard = [group.get(tally, 0), group.get(tally, 1), prepared]
        went = launched_now
        ended = finished_now
        out none
    }

    skill count() {
        @made = checks.checks()
        @now_target = (group.get(made, 0) + group.get(made, 1)) * 1000
        @spent = gone(counted_at)
        counted_at = time.now()
        (now_target > target) {
            (spent > 0) {
                @measured = (now_target - target) / spent
                pace = (pace * 3 + measured) / 4
            }
        }
        target = now_target
        out none
    }

    skill glide(spent) {
        @gap = target - shown
        (gap <= 0) {
            shown = target
            out no
        }
        @step = pace * spent + (gap * spent) / 1500
        (step < spent * 10) { step = spent * 10 }
        (step > gap) { step = gap }
        shown = shown + step
        out yes
    }

    skill live() {
        @tally = checks.counts()
        (group.get(tally, 2) > 0) { out yes }
        out (checks.finished() == no)
    }

    skill step() {
        (link.way_closed == yes) { out no }
        (link.way_failed == yes) { out no }
        screen.pump(link, packet, hold, joined)
        @drained = reader.drain(link.way_events)
        link.way_events = drained.core
        @changed = no
        drum (drained.gestures) {
            (beat.kind == gestures.Kind.CLICK) {
                @hit = jtml.hit(runtime, beat.x, beat.y)
                (click(hit.id) == yes) { changed = yes }
            }
            (beat.kind == gestures.Kind.WHEEL) {
                first = first + beat.amount
                (first < 0) { first = 0 }
                @last = group.count(checks.field) - 1
                (first > last) { first = last }
                changed = yes
            }
        }
        @running = live()
        (changed == yes) {
            build()
            show()
            changed = no
        }
        (gone(read_at) >= READ) {
            read_at = time.now()
            checks.ask()
            ask_log()
        }
        (checks.collect() == yes) {
            count()
            listen()
            changed = yes
        }
        (take_log() == yes) { changed = yes }
        (gone(fps_at) >= 1000) {
            fps_at = time.now()
            log.fps = group.add(log.fps, frames)
            @kept = group.count(log.fps)
            (kept > page.FPS_SECONDS) { log.fps = group.slice(log.fps, kept - page.FPS_SECONDS, kept) }
            frames = 0
            changed = yes
        }
        @frame = gone(spun_at)
        spun_at = time.now()
        (glide(frame) == yes) { changed = yes }
        (running == yes) {
            tick = ((time.now() % TURN) * 360) / TURN
            changed = yes
        }
        (changed == yes) {
            build()
            show()
            out yes
        }
        socket.sleep(16)
        out yes
    }
}

program() {
    @window = Window {}
    window.open()
    always {
        (window.step() == no) { leave }
    }
    out none
}
