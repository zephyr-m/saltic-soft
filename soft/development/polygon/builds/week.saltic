-- week — неделя календаря коммитов, субъект Week: семь дней с понедельника
-- (day.Day). Сама рисует свой столбик клеток и знает, начинается ли в ней
-- месяц — тогда над столбиком его подпись.
--
-- Week { days } — cells() -> столбик клеток дней; month() -> «ноя», если в
--     неделе первое число месяца, иначе ""; at(slot) -> день недели 0…6

use core.group
use tarantul.uiengine.jtml.calls

Week = Box {
    days = []

    skill at(slot) {
        out group.get(days, slot)
    }

    skill month() {
        drum (group.count(days)) {
            @day_2 = group.get(days, beat)
            (day_2.opens_month() == yes) { out day_2.month_short() }
        }
        out ""
    }

    skill cells() {
        @cells = []
        drum (group.count(days)) {
            @day_2 = group.get(days, beat)
            cells = group.add(cells, day_2.cell())
        }
        @inside = calls.join(cells)
        out "\{\"box\": \{\"gap\": 4, \"children\": [{inside}]\}\}"
    }
}
