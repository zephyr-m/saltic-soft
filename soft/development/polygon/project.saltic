-- project — экран «saltic» Полигона, субъект Project: сам язык в числах из
-- его дома (SALTIC_HOME, по умолчанию ../saltic — соседний репозиторий). Код — файлы .saltic из git ls-files (свои и новые, без
-- игнорируемых), строки — str.line_count каждого, по верхним папкам (AREAS —
-- в порядке показа, прочее — «другое»); пирамида жителей UIEngine — прямо из
-- собранной библиотеки (library.LEVELS, атомов — ATOMS); полка — компиляторы
-- в bootstrap/ (имя saltic-<версия>-compiler-<цель>); тем — themes.NAMES.
--
-- Project { files, lines, areas, compilers, version, trouble } — файлов и строк
--     Saltic, строк по AREAS, процессоры компиляторов на полке, версия полки,
--     причина сбоя или ""
--     refresh() — пересчитать; jtml() -> список JTML экрана; home() -> дом языка
--     shelf(flow, gap, items) — ряд или столбик; grouped(number) -> «105 952»
--     — большое число с разрядами; widest(items) -> наибольшее число
-- Внутри: shelf_of(names) — процессоры и версия полки; floors() — пирамида;
--     code() — код по частям; widest(items) -> наибольшее число

use core.str
use core.group
use core.process
use io.file
use tarantul.uiengine.library
use tarantul.uiengine.themes
use tarantul.uiengine.jtml.calls

AREAS = ["soul", "workbench", "tests", "formats"]
ATOMS = 4
PREFIX = "saltic-"
MARK = "-compiler-"
TRACK = 300
FLOORS = [[4, "этаж 4 · экраны", "info"], [3, "этаж 3 · блоки", "accent"], [2, "этаж 2 · кирпичи", "up"], [1, "атомы", "mustard"]]




Project = Box {
    files = 0,
    lines = 0,
    areas = [],
    compilers = [],
    version = "",
    trouble = ""

    skill shelf(flow, gap, items) {
        @inside = calls.join(items)
        out "\{\"box\": \{\"flow\": \"{flow}\", \"gap\": {gap}, \"children\": [{inside}]\}\}"
    }

    skill grouped(number) {
        @text = "{number}"
        @made = ""
        @size = str.bytes(text)
        drum (size) {
            ((beat == 0) == no) {
                ((size - beat) % 3 == 0) { made = "{made} " }
            }
            @digit = str.get(text, beat)
            made = "{made}{digit}"
        }
        out made
    }

    skill widest(items) {
        @most = 1
        drum (items) {
            (beat > most) { most = beat }
        }
        out most
    }

    skill home() {
        @settings = process.environment()
        drum (settings) {
            @setting = group.get(settings, beat)
            (str.starts_with(setting, "SALTIC_HOME=") == yes) {
                out str.slice(setting, 12, str.bytes(setting))
            }
        }
        out "../saltic"
    }

    skill refresh() {
        @root = home()
        @listed = process.capture(["git", "ls-files", "--cached", "--others", "--exclude-standard", "*.saltic"], root, []) rescue |err| {
            trouble = "git не запустился — {err}"
            out none
        }
        @counted = []
        drum (group.count(AREAS) + 1) {
            counted = group.add(counted, 0)
        }
        files = 0
        lines = 0
        @paths = str.lines(listed.output)
        drum (paths) {
            @path = group.get(paths, beat)
            @text = file.read("{root}/{path}") rescue |err| { "" }
            ((text == "") == no) {
                @many = str.line_count(text)
                files = files + 1
                lines = lines + many
                @top = group.get(str.split(path, "/"), 0)
                @slot = group.count(AREAS)
                drum (AREAS) {
                    (group.get(AREAS, beat) == top) { slot = beat }
                }
                counted = group.replaced(counted, slot, group.get(counted, slot) + many)
            }
        }
        areas = counted
        shelf_of(file.list("{root}/bootstrap"))
        trouble = ""
        out none
    }

    skill shelf_of(names) {
        @found = []
        drum (names) {
            @name = group.get(names, beat)
            (str.starts_with(name, PREFIX) == yes) {
                (str.contains(name, MARK) == yes) {
                    (str.ends_with(name, ".txt") == no) {
                        @parts = str.split(name, MARK)
                        @chip = group.get(str.split(group.get(parts, 1), "-"), 0)
                        (group.contains(found, chip) == no) { found = group.add(found, chip) }
                        @raw = str.slice(group.get(parts, 0), str.bytes(PREFIX), str.bytes(group.get(parts, 0)))
                        version = str.join(str.split(raw, "-"), ":")
                    }
                }
            }
        }
        compilers = found
        out none
    }

    skill count_of(counts, floor) {
        out group.get(counts, group.get(floor, 0))
    }

    skill floors() {
        @counts = [0, ATOMS, 0, 0, 0]
        drum (library.LEVELS) {
            @level = group.get(library.LEVELS, beat)
            counts = group.replaced(counts, level, group.get(counts, level) + 1)
        }
        @most = widest(counts)
        @rows = []
        drum (FLOORS) {
            @floor_2 = group.get(FLOORS, beat)
            @many = count_of(counts, floor_2)
            @width = many * TRACK / most + 8
            rows = group.add(rows, calls.call("floor-bar", [["label", calls.quoted(group.get(floor_2, 1))], ["count", calls.quoted("{many}")], ["width", "{width}"], ["tone", calls.quoted(group.get(floor_2, 2))]]))
        }
        out calls.call("console-panel", [["title", calls.quoted("пирамида жителей UIEngine")], ["note", calls.quoted("из собранной библиотеки")], ["radius", "16"], ["grow", "1"], ["children", calls.listed([shelf("column", 6, rows)])]])
    }

    skill code() {
        @most = widest(areas)
        @rows = []
        @names = group.concat(AREAS, ["другое"])
        drum (names) {
            @many = group.get(areas, beat)
            @width = many * TRACK / most + 4
            rows = group.add(rows, calls.call("bar-row", [["label", calls.quoted(group.get(names, beat))], ["value", calls.quoted("{many}")], ["width", "{width}"], ["tone", calls.quoted("accent_mid")]]))
        }
        out calls.call("console-panel", [["title", calls.quoted("строки Saltic по частям")], ["note", calls.quoted("git ls-files")], ["radius", "16"], ["grow", "1"], ["children", calls.listed([shelf("column", 4, rows)])]])
    }

    skill jtml() {
        ((trouble == "") == no) {
            @failed = calls.call("page-head", [["title", calls.quoted("Saltic")], ["note", calls.quoted(trouble)], ["badge", calls.quoted("нет данных")], ["tone", calls.quoted("down")]])
            out calls.listed([failed])
        }
        @residents = group.count(library.NAMES)
        @kinds = group.count(themes.NAMES)
        @targets = group.count(compilers)
        @spaced = grouped(lines)
        @stats = shelf("row", 14, [calls.call("stat-panel", [["label", calls.quoted("строк Saltic")], ["value", calls.quoted(spaced)], ["tone", calls.quoted("accent")], ["size", "64"], ["note", calls.quoted("в {files} файлах .saltic этого репозитория")], ["grow", "2"]]), calls.call("stat-panel", [["label", calls.quoted("жителей UIEngine")], ["value", calls.quoted("{residents}")], ["tone", calls.quoted("up")], ["size", "34"], ["note", calls.quoted("строго по этажам")], ["grow", "1"]]), calls.call("stat-panel", [["label", calls.quoted("тем")], ["value", calls.quoted("{kinds}")], ["tone", calls.quoted("mustard")], ["size", "34"], ["note", calls.quoted("выбор — одним словом")], ["grow", "1"]]), calls.call("stat-panel", [["label", calls.quoted("процессоров на полке")], ["value", calls.quoted("{targets}")], ["tone", calls.quoted("info")], ["size", "34"], ["note", calls.quoted(str.join(compilers, ", "))], ["grow", "1"]])])
        @head = calls.call("page-head", [["title", calls.quoted("Saltic")], ["note", calls.quoted("сам язык — числа из этого репозитория")], ["badge", calls.quoted("полка {version}")], ["tone", calls.quoted("mustard")]])
        out calls.listed([head, stats, shelf("row", 14, [code(), floors()])])
    }
}
