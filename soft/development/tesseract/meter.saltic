-- meter — график кадров Tesseract на своём холсте WIDE × HIGH: сколько миллисекунд
-- ушло на кадр (столбики последних SPAN кадров, черта — 60 к/с), на сколько
-- кадров в секунду хватило бы рисования и сколько кадров реально показано за
-- прошлую секунду. Время — core.time, миллисекунды.
--
-- Meter { spent, head, second, frames, rate } — spent — table.Table по кругу:
--     мс последних SPAN кадров, head — куда писать следующий; second — начало
--     текущей секунды; frames — кадров в ней; rate — кадров за прошлую
--     readied() — круг в своей памяти, до первого кадра
--     finished(start) — записать кадр, начатый в start (time.now())
--     took(age) -> мс кадра age шагов назад (0 — последний)
--     average() -> среднее последних кадров в десятых долях мс
--     drawn(canvas, face) — панель с числами и графиком в (0, 0) холста
-- SPAN — кадров в графике; CEILING — мс на верх графика; WIDE, HIGH — панель;
--     BAR — ширина столбика; GRAPH — высота графика; RECENT — кадров в среднем

use core.group
use core.time
use tarantul.graphics.graphics
use tarantul.uiengine.draw.typeface
use soft.development.tesseract.table

SPAN = 120
CEILING = 50
WIDE = 264
HIGH = 116
BAR = 2
GRAPH = 60
RECENT = 30

Meter = Box {
    spent = table.Table {},
    head = 0,
    second = 0,
    frames = 0,
    rate = 0

    skill finished(start) {
        @now = time.now()
        @cost = now - start
        (cost < 0) {
            cost = cost + time.DAY_MILLISECONDS
        }
        spent.put(head, 0, cost)
        head = (head + 1) % SPAN
        (spent.count < SPAN) {
            spent.count = spent.count + 1
        }
        frames = frames + 1
        @passed = now - second
        (passed < 0) {
            passed = passed + time.DAY_MILLISECONDS
        }
        (passed >= 1000) {
            rate = frames * 1000 / passed
            frames = 0
            second = now
        }
    }

    skill readied() {
        spent = table.table_of("tesseract-spent", 1, SPAN)
    }

    skill took(age) {
        out spent.at((head - 1 - age + SPAN * 2) % SPAN, 0)
    }

    skill average() {
        @count = spent.count
        (count == 0) {
            out 0
        }
        @tail = RECENT
        (count < tail) {
            tail = count
        }
        @sum = 0
        drum (tail) {
            sum = sum + took(beat)
        }
        out sum * 10 / tail
    }

    skill drawn(canvas, face) {
        @left = 0
        @top = 0
        graphics.fill(canvas, 0, 0, WIDE, HIGH, graphics.color(canvas, 17, 23, 35))
        @tenths = average()
        @whole = tenths / 10
        @part = tenths % 10
        @enough = "больше 1000"
        (tenths > 0) {
            @fast = 10000 / tenths
            enough = "{fast}"
        }
        @brush = typeface.Brush {
            size = 12,
            ink = graphics.color(canvas, 196, 202, 214),
            fade = graphics.color(canvas, 196, 202, 214),
            spacing = 0
        }
        typeface.paint(canvas, face, left + 12, top + 10, "кадр {whole}.{part} мс · хватит на {enough} к/с", brush)
        typeface.paint(canvas, face, left + 12, top + 28, "показано {rate} к/с", brush)
        @base = top + HIGH - 10
        @mark = base - 1667 * GRAPH / (CEILING * 100)
        graphics.fill(canvas, left + 12, mark, SPAN * BAR, 1, graphics.color(canvas, 93, 102, 117))
        @good = graphics.color(canvas, 76, 205, 255)
        @slow = graphics.color(canvas, 228, 183, 64)
        @bad = graphics.color(canvas, 235, 87, 87)
        @count = spent.count
        drum (count) {
            @cost = took(count - 1 - beat)
            @height = cost * GRAPH / CEILING
            (height > GRAPH) {
                height = GRAPH
            }
            (height < 1) {
                height = 1
            }
            @ink = good
            (cost > 16) {
                ink = slow
            }
            (cost > 33) {
                ink = bad
            }
            graphics.fill(canvas, left + 12 + beat * BAR, base - height, BAR - 1, height, ink)
        }
    }
}
