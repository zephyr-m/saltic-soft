-- skeleton — скелет машины для Tesseract: три измерения (этаж, сектор, время)
-- и какое из них стоит на какой оси. Пакетов нет — только клетки. Платформа —
-- не измерение: она по ту сторону драйвера, скелет стоит на ней. Этажи — из
-- docs/Этажи_экосистемы_от_подвала_до_среды.md языка, сектора — колесо
-- (docs/site/private/WHEEL-DATA.js, HUMAN): пока список живёт здесь вторым
-- способом, страница браузера уйдёт — останется один.
--
-- Skeleton { axes } — axes — [измерение по X, по Y, по Z], номера в TITLES и VALUES
--     dimension_size(dimension) -> сколько значений
--     dimension_title(dimension) -> «ЭТАЖ», «СЕКТОР», «ВРЕМЯ»
--     value_label(dimension, index) -> подпись значения («П0 · машина»)
--     value_about(dimension, index) -> что тут живёт, одной строкой
--     on_axis(axis) -> номер измерения на оси 0 (X), 1 (Y), 2 (Z)
--     rotated() — оси по кругу: X → Y → Z → X; swapped() — X и Z местами
--     cellar(dimension, index) -> yes, если это слой подвала
-- FLOORS, SECTORS, RHYTHMS — значения [подпись, описание]; BASEMENT — слоёв
--     подвала; FLOOR — номер измерения «этаж»; TITLES, VALUES — заголовки и значения измерений

use core.group

BASEMENT = 4
FLOOR = 0
FLOORS = [
    ["П0 · машина", "голая машина: регистры, порты, память, адреса"],
    ["П1 · прошивка", "прошивка и шины: UEFI, PCI, прерывания"],
    ["П2 · драйвер", "драйвер конкретной железки"],
    ["П3 · устройства", "класс устройства: сеть, экран, указатель, диск"],
    ["1 · атомы", "атомы языка: число, байты, текст, группа"],
    ["2 · приёмы", "простые приёмы: hex, хеши, bignum"],
    ["3 · молекулы", "молекулы: karatsuba, hmac, x25519"],
    ["4 · примитивы", "примитивы протоколов и форматов: rsa, tcp, png"],
    ["5 · протоколы", "составные протоколы: tls, http, json, раскладка текста"],
    ["6 · движки", "движки: страницы, JS, база, 3D, нейросети"],
    ["7 · под ключ", "решения под ключ: «показать страницу», «чат»"],
    ["8 · программы", "программы: браузер, мессенджер, IDE"],
    ["9 · среда", "среда: рабочий стол, окно между ноутбуками"]
]
SECTORS = [
    ["Разум", "оси: Число"],
    ["Деньги", "оси: Число"],
    ["Защита", "оси: Число"],
    ["Данные", "оси: Число"],
    ["Система", "оси: Число, Электричество"],
    ["Электроника", "оси: Электричество"],
    ["Связь", "оси: Электричество, Радио"],
    ["Карты и место", "оси: Радио, Пространство и время"],
    ["Наука и расчёты", "оси: Пространство и время, Движение"],
    ["Механика", "оси: Движение"],
    ["Музыка и речь", "оси: Звук"],
    ["Графика", "оси: Свет"],
    ["Видео и камера", "оси: Свет"],
    ["Интерфейс", "оси: Свет, Число"]
]
RHYTHMS = [
    ["такт", "наносекунды: команда, метроном"],
    ["прерывание", "микросекунды: железо ждёт ответа"],
    ["кадр", "миллисекунды: экран, звук, физика"],
    ["запрос", "секунды: сеть, человек нажал"],
    ["сессия", "часы: программа открыта"],
    ["хранение", "годы: файлы, память"]
]
TITLES = ["ЭТАЖ", "СЕКТОР", "ВРЕМЯ"]
VALUES = [FLOORS, SECTORS, RHYTHMS]

Skeleton = Box {
    axes = [1, 0, 2]

    skill dimension_size(dimension) {
        out group.count(group.get(VALUES, dimension))
    }

    skill dimension_title(dimension) {
        out group.get(TITLES, dimension)
    }

    skill value_label(dimension, index) {
        @values = group.get(VALUES, dimension)
        out group.get(group.get(values, index), 0)
    }

    skill value_about(dimension, index) {
        @values = group.get(VALUES, dimension)
        out group.get(group.get(values, index), 1)
    }

    skill on_axis(axis) {
        out group.get(axes, axis)
    }

    skill rotated() {
        axes = [group.get(axes, 2), group.get(axes, 0), group.get(axes, 1)]
    }

    skill swapped() {
        axes = [group.get(axes, 2), group.get(axes, 1), group.get(axes, 0)]
    }

    skill cellar(dimension, index) {
        ((dimension == FLOOR) ○ (index < BASEMENT)) {
            out yes
        }
        out no
    }
}
