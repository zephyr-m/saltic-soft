-- trace — кадр в движении без стирания экрана, как в wire: рядом с холстом —
-- слой отметок того же размера, по числу на точку. Новые отрезки кадра пишутся
-- с отметкой кадра, потом старые отрезки гаснут только там, где отметка не
-- свежая: горящую точку не трогают, пустого экрана не бывает. Места «навсегда»
-- (шапка, график) отрезки не задевают. Цвета — сплошные: полупрозрачное чисто
-- не погасить.
--
-- Trace { canvas, marks, stamp, banks, now, places } — canvas — куда рисовать;
--     marks — слой отметок того же stride, что canvas; banks — две table.Table
--     штрихов [вид, x0, y0, x1, y1] (вид LINE или DOT): now — этого кадра,
--     другая — прошлого; places — места «навсегда» [x, y, ширина, высота]
--     banked(name) — банки в своей памяти, до первого кадра
--     began() — новый кадр; line(x0, y0, x1, y1, value) — отрезок с отметкой
--     dot(x, y, value) — крестик в 5 точек с отметкой
--     finished(background) — погасить старое фоном
--     forgot() — прошлого кадра нет: все отметки в ноль, места «навсегда» заново
--     kept(x, y, width, height) — место «навсегда»
--     walk(x0, y0, x1, y1, value, lit) / cross(x, y, value, lit) / touch(x, y,
--     value, lit) — отрезок, крестик, точка: lit — зажечь, иначе погасить
-- canvas_of(name, width, height, format) -> graphics.Screen в своей памяти (memfd);
--     CanvasFailed — память не дали
-- put(from, to, x, y) — холст from целиком на холст to в (x, y), за краем — ничего
-- copied(from, to, x, y, width, height) — кусок с from на то же место to
--     (холсты одного размера), за краем — ничего
-- FOREVER — отметка «навсегда»; FIRST — отметка первого кадра; CROSS — точки
--     крестика; LINE, DOT — виды штриха; STROKES — штрихов в банке

use core.mem
use core.num
use core.u32
use core.usize
use core.group
use core.socket
use core.address
use tarantul.graphics.graphics
use soft.development.tesseract.table

FOREVER = 1
FIRST = 2
CROSS = [[0, 0], [-1, 0], [1, 0], [0, -1], [0, 1]]
LINE = 4
DOT = 2
STROKES = 8192

Trace = Box {
    canvas = graphics.Screen {},
    marks = graphics.Screen {},
    stamp = FIRST,
    banks = [],
    now = 0,
    places = []

    skill banked(name) {
        banks = [table.table_of("{name}-a", 5, STROKES), table.table_of("{name}-b", 5, STROKES)]
    }

    skill began() {
        stamp = stamp + 1
        @fresh = group.get(banks, now)
        fresh.cleared()
    }

    skill line(x0, y0, x1, y1, value) {
        @fresh = group.get(banks, now)
        fresh.added([LINE, x0, y0, x1, y1])
        walk(x0, y0, x1, y1, value, yes)
    }

    skill dot(x, y, value) {
        @fresh = group.get(banks, now)
        fresh.added([DOT, x, y, 0, 0])
        cross(x, y, value, yes)
    }

    skill cross(x, y, value, lit) {
        drum (CROSS) {
            @entry = group.get(CROSS, beat)
            touch(x + group.get(entry, 0), y + group.get(entry, 1), value, lit)
        }
    }

    skill touch(x, y, value, lit) {
        ((x < 0) ○○ (y < 0)) {
            out none
        }
        ((x >= canvas.width) ○○ (y >= canvas.height)) {
            out none
        }
        @at = usize.from((y * canvas.stride + x) * graphics.PIXEL_BYTES)
        @field = address.from(marks.memory)
        @was = num.from(mem.load32(field, at))
        (was == FOREVER) {
            out none
        }
        (lit == yes) {
            mem.store32(field, at, u32.from(stamp))
            mem.store32(address.from(canvas.memory), at, u32.from(value))
            out none
        }
        ((was == stamp) ○○ (was == 0)) {
            out none
        }
        mem.store32(field, at, u32.from(0))
        mem.store32(address.from(canvas.memory), at, u32.from(value))
    }

    skill finished(background) {
        @old = group.get(banks, 1 - now)
        drum (old.count) {
            (old.at(beat, 0) == DOT) {
                cross(old.at(beat, 1), old.at(beat, 2), background, no)
            }
            (old.at(beat, 0) == LINE) {
                walk(old.at(beat, 1), old.at(beat, 2), old.at(beat, 3), old.at(beat, 4), background, no)
            }
        }
        old.cleared()
        now = 1 - now
    }

    skill forgot() {
        graphics.fill(marks, 0, 0, marks.width, marks.height, 0)
        drum (places) {
            @place = group.get(places, beat)
            graphics.fill(marks, group.get(place, 0), group.get(place, 1), group.get(place, 2), group.get(place, 3), FOREVER)
        }
        drum (banks) {
            @bank = group.get(banks, beat)
            bank.cleared()
        }
    }

    skill kept(x, y, width, height) {
        places = group.add(places, [x, y, width, height])
        graphics.fill(marks, x, y, width, height, FOREVER)
    }

    skill walk(x0, y0, x1, y1, value, lit) {
        @dx = x1 - x0
        @step_x = 1
        (dx < 0) {
            dx = 0 - dx
            step_x = -1
        }
        @dy = y1 - y0
        @step_y = 1
        (dy < 0) {
            dy = 0 - dy
            step_y = -1
        }
        @count = dx + 1
        (dy > dx) {
            count = dy + 1
        }
        @x = x0
        @y = y0
        @drift = dx - dy
        @base = address.from(canvas.memory)
        @field = address.from(marks.memory)
        @point = u32.from(value)
        @mark = u32.from(stamp)
        @blank = u32.from(0)
        drum (count) {
            @inside = (((x >= 0) ○ (y >= 0)) ○ ((x < canvas.width) ○ (y < canvas.height)))
            (inside == yes) {
                @at = usize.from((y * canvas.stride + x) * graphics.PIXEL_BYTES)
                @was = num.from(mem.load32(field, at))
                (lit == yes) {
                    ((was == FOREVER) == no) {
                        mem.store32(field, at, mark)
                        mem.store32(base, at, point)
                    }
                }
                (lit == no) {
                    ((((was == FOREVER) ○○ (was == stamp)) ○○ (was == 0)) == no) {
                        mem.store32(field, at, blank)
                        mem.store32(base, at, point)
                    }
                }
            }
            @twice = drift * 2
            (twice > 0 - dy) {
                drift = drift - dy
                x = x + step_x
            }
            (twice < dx) {
                drift = drift + dx
                y = y + step_y
            }
        }
    }
}

skill canvas_of(name, width, height, format) {
    @bytes = width * height * graphics.PIXEL_BYTES
    @fd = socket.memory(name)
    (fd < 0) {
        out error.CanvasFailed
    }
    (socket.resize(fd, bytes) < 0) {
        out error.CanvasFailed
    }
    @memory = socket.map(fd, bytes)
    (memory < 0) {
        out error.CanvasFailed
    }
    out graphics.Screen {
        width = width,
        height = height,
        stride = width,
        format = format,
        frame = 0,
        memory = memory,
        accel = [],
        vsync = no
    }
}

skill copied(from, to, x, y, width, height) {
    @source = address.from(from.memory)
    @target = address.from(to.memory)
    @left = x
    @right = x + width
    (left < 0) {
        left = 0
    }
    (right > from.width) {
        right = from.width
    }
    drum (height) {
        @row = y + beat
        (((row >= 0) ○ (row < from.height)) ○ (left < right)) {
            drum (right - left) {
                @at = usize.from((row * from.stride + left + beat) * graphics.PIXEL_BYTES)
                mem.store32(target, at, mem.load32(source, at))
            }
        }
    }
}

skill put(from, to, x, y) {
    @source = address.from(from.memory)
    @target = address.from(to.memory)
    drum (from.height) {
        @row = beat
        @ty = y + row
        ((ty >= 0) ○ (ty < to.height)) {
            drum (from.width) {
                @tx = x + beat
                ((tx >= 0) ○ (tx < to.width)) {
                    @value = mem.load32(source, usize.from((row * from.stride + beat) * graphics.PIXEL_BYTES))
                    mem.store32(target, usize.from((ty * to.stride + tx) * graphics.PIXEL_BYTES), value)
                }
            }
        }
    }
}
