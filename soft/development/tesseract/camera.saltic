-- camera — глаз Tesseract: поворот (yaw) и наклон (pitch) — дробные радианы,
-- синус и косинус считаются раз на поворот и хранятся целыми ×SCALE; сама
-- проекция — в целых: мир — тысячные доли единицы, экран — точки.
--
-- Camera { yaw, pitch, yaw_raw, pitch_raw, flat, distance, pan_x, pan_y, center_x,
--     center_y, focal, cos_yaw, sin_yaw, cos_pitch, sin_pitch } — yaw_raw,
--     pitch_raw — куда натянула мышь, yaw, pitch — они же с магнитом к ровным
--     углам; flat — yes: прямая проекция (без перспективы, как чертёж);
--     distance — до центра, ×1000
--     aimed(width, height) — центр и фокус по размеру окна
--     turned() — магнит и синусы после поворота
--     dragged_by(dx, dy) — тяга левой: вправо — поворот, вниз — наклон вверх
--     faced(view) — ровный вид: FRONT, SIDE, TOP; flattened() — перспектива ↔ прямая
--     snapped(angle) -> angle, а в SNAP от кратного четверти оборота — оно само
--     moved_by(dx, dy) — тяга средней: сдвиг картинки
--     zoomed(steps) — колесо: вниз — дальше, вверх — ближе
--     seen(x, y, z) -> [экранный x, экранный y, глубина ×1000]
-- SCALE — множитель целых синусов; TURN — радиан на точку тяги; NEAREST,
--     FARTHEST — пределы расстояния; QUARTER — четверть оборота; SNAP — ширина
--     магнита; FRONT, SIDE, TOP — виды

use core.num
use core.fraction

SCALE = 4096
TURN = 0.008
NEAREST = 2400
FARTHEST = 9000
QUARTER = 1.5707963
SNAP = 0.04
FRONT = 0
SIDE = 1
TOP = 2

Camera = Box {
    yaw = -0.3,
    pitch = 0.3,
    yaw_raw = -0.3,
    pitch_raw = 0.3,
    flat = no,
    distance = 5200,
    pan_x = 0,
    pan_y = 0,
    center_x = 0,
    center_y = 0,
    focal = 0,
    cos_yaw = 4096,
    sin_yaw = 0,
    cos_pitch = 4096,
    sin_pitch = 0

    skill aimed(width, height) {
        center_x = width * 60 / 100
        center_y = height * 47 / 100
        focal = height * 95 / 100
        (width < height) {
            focal = width * 95 / 100
        }
        turned()
    }

    skill snapped(angle) {
        @near = fraction.from(num.round_school(angle / QUARTER)) * QUARTER
        @gap = angle - near
        ((gap < SNAP) ○ (gap > 0.0 - SNAP)) {
            out near
        }
        out angle
    }

    skill turned() {
        yaw = snapped(yaw_raw)
        pitch = snapped(pitch_raw)
        @scale = fraction.from(SCALE)
        cos_yaw = num.round_school(fraction.cos(yaw) * scale)
        sin_yaw = num.round_school(fraction.sin(yaw) * scale)
        cos_pitch = num.round_school(fraction.cos(pitch) * scale)
        sin_pitch = num.round_school(fraction.sin(pitch) * scale)
    }

    skill dragged_by(dx, dy) {
        yaw_raw = yaw_raw + fraction.from(dx) * TURN
        pitch_raw = pitch_raw - fraction.from(dy) * TURN
        (pitch_raw > QUARTER) {
            pitch_raw = QUARTER
        }
        (pitch_raw < 0.0 - QUARTER) {
            pitch_raw = 0.0 - QUARTER
        }
        turned()
    }

    skill faced(view) {
        yaw_raw = 0.0
        pitch_raw = 0.0
        (view == SIDE) {
            yaw_raw = QUARTER
        }
        (view == TOP) {
            pitch_raw = QUARTER
        }
        pan_x = 0
        pan_y = 0
        turned()
    }

    skill flattened() {
        flat = (flat == no)
    }

    skill moved_by(dx, dy) {
        pan_x = pan_x + dx
        pan_y = pan_y + dy
    }

    skill zoomed(steps) {
        distance = distance * (10 + steps) / 10
        (distance < NEAREST) {
            distance = NEAREST
        }
        (distance > FARTHEST) {
            distance = FARTHEST
        }
    }

    skill seen(x, y, z) {
        @x1 = (x * cos_yaw - z * sin_yaw) / SCALE
        @z1 = (x * sin_yaw + z * cos_yaw) / SCALE
        @y2 = (y * cos_pitch - z1 * sin_pitch) / SCALE
        @z2 = (y * sin_pitch + z1 * cos_pitch) / SCALE
        @depth = distance + z2
        (depth < 300) {
            depth = 300
        }
        @lens = depth
        (flat == yes) {
            lens = distance
        }
        out [center_x + pan_x + x1 * focal / lens, center_y + pan_y - y2 * focal / lens, depth]
    }
}
