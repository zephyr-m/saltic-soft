-- install — поставить программу saltic-soft на этот ноут, `just install <имя>`:
-- компилятор и язык — из дома Saltic (SALTIC_HOME, по умолчанию ../saltic);
-- собрать, положить бинарник в ~/.local/bin, положить иконку — цветной SVG
-- Fluent Color из ICONS (Microsoft, MIT, лицензия рядом); у SalticIDE — свой
-- логотип языка `<>` PNG 64×64, записать визитку .desktop в меню приложений и ярлык на рабочий
-- стол (стандарт freedesktop: KDE, GNOME). Программа запускается в корне
-- проекта (Path=), чтобы видеть его файлы. Печатает ход по шагам.
--
-- PROGRAMS — [имя, исходник, название, описание, категории, значок (имя SVG
--     в ICONS или "logo"), аргументы запуска из меню ("" — без них)]
-- program(name) — поставить программу name; нет такой — список доступных
-- Внутри: entry(name) -> запись PROGRAMS или []; variable(key) -> значение
--     переменной окружения; folder_of(command) -> вывод команды без «\n»;
--     covered(px, py, line) / painted(px, py, lines) -> yes, если точка у отрезка
--     (толщина пера PEN); logo() -> буфер точек иконки; visiting(…) -> текст
--     визитки; must(code, what) — провал шага → InstallFailed; refresh() — меню KDE
--     picture(found, icons, name) -> путь поставленной иконки

use io
use io.file
use core.str
use core.group
use core.bytes
use core.process
use workbench.check.view.png

PROGRAMS = [
    ["salticide", "soft/development/salticide/linux/main.saltic", "SalticIDE", "IDE языка Saltic", "Development;", "logo", ""],
    ["jtmlview", "soft/development/jtmlview/main.saltic", "jtml-view", "Жители UIEngine настоящим движком", "Development;", "apps", ""],
    ["polygon", "soft/development/polygon/main.saltic", "Полигон Saltic", "Сборки и железо — экран на жителях UIEngine", "Development;", "toolbox", ""],
    ["tesseract", "soft/development/tesseract/main.saltic", "Tesseract", "Скелет машины: этажи, сектора и время — клетки-кубики в 3D", "Development;", "apps", ""],
    ["scene", "soft/graphics/scene/main.saltic", "Сцена", "Оболочка 3D-редактора на жителях UIEngine — образец, движка ещё нет", "Graphics;", "image", ""],
    ["crystal", "soft/graphics/crystal/main.saltic", "Кристалл", "Гранёный кристалл с трассировкой лучей: вращается, свет преломляется в гранях", "Graphics;", "weather-snowflake", "window"],
    ["mail", "soft/communication/mail/main.saltic", "Почта", "Почтовый клиент на жителях UIEngine — образец, почта не подключена", "Network;Email;", "mail", ""],
    ["bastion", "soft/games/bastion/main.saltic", "Бастион", "Оборона башнями: мастер строит и улучшает сам, игра идёт без тебя", "Game;", "shield", ""],
    ["gems", "soft/games/gems/main.saltic", "Самоцветы", "Три в ряд: камни, лучи, звёзды и цепочки", "Game;", "premium", ""],
    ["catcher", "soft/learning/catcher/main.saltic", "Ловец", "Нейросеть учится ловить мяч у тебя на глазах — DQN с нуля", "Education;", "bot", ""],
    ["serpent", "soft/learning/serpent/main.saltic", "Змея учится", "Нейросеть учится играть в «Змейку» у тебя на глазах — DQN с нуля", "Education;", "bot-sparkle", ""]
]
HEAP = "268435456"
SIZE = 64
PEN = 49
ICONS = "tools/icons/fluent"
INK = [[47, 38, 33], [233, 128, 95], [63, 166, 184]]
CORAL = [[20, 6, 6, 20], [6, 20, 20, 34]]
TEAL = [[36, 6, 50, 20], [50, 20, 36, 34]]

skill entry(name) {
    drum (PROGRAMS) {
        (group.get(beat, 0) == name) { out beat }
    }
    out []
}

skill variable(key) {
    @head = "{key}="
    drum (process.environment()) {
        (str.starts_with(beat, head) == yes) { out str.slice(beat, str.bytes(head), str.bytes(beat)) }
    }
    out ""
}

skill folder_of(command) {
    @done = process.capture(command, "", []) rescue |err| { out "" }
    @text = done.output
    (str.ends_with(text, "\n") == yes) { text = str.slice(text, 0, str.bytes(text) - 1) }
    out text
}

skill covered(px, py, line) {
    @ax = group.get(line, 0) * 2 + 8
    @ay = group.get(line, 1) * 2 + 24
    @bx = group.get(line, 2) * 2 + 8
    @by = group.get(line, 3) * 2 + 24
    @abx = bx - ax
    @aby = by - ay
    @apx = px - ax
    @apy = py - ay
    @dot = apx * abx + apy * aby
    @length = abx * abx + aby * aby
    (dot <= 0) { out apx * apx + apy * apy <= PEN }
    (dot >= length) { out (px - bx) * (px - bx) + (py - by) * (py - by) <= PEN }
    @cross = apx * aby - apy * abx
    out cross * cross <= PEN * length
}

skill painted(px, py, lines) {
    drum (lines) {
        (covered(px, py, beat) == yes) { out yes }
    }
    out no
}

skill picture(found, icons, name) {
    (group.get(found, 5) == "logo") {
        @drawn = "{icons}/saltic-{name}.png"
        file.write_bytes(drawn, png.encode(logo(), SIZE, SIZE, INK))
        out drawn
    }
    @icon = group.get(found, 5)
    @placed = "{icons}/saltic-{name}.svg"
    must(process.run(["install", "-Dm644", "{ICONS}/{icon}.svg", placed], "", []), "иконка {ICONS}/{icon}.svg")
    out placed
}

skill logo() {
    @pixels = bytes.new(SIZE * SIZE)
    drum (SIZE * SIZE) {
        @px = (beat % SIZE) * 2 + 1
        @py = (beat / SIZE) * 2 + 1
        @color = 0
        (painted(px, py, CORAL) == yes) { color = 1 }
        (painted(px, py, TEAL) == yes) { color = 2 }
        bytes.set(pixels, beat, color)
    }
    out pixels
}

skill visiting(title, comment, binary, root, face, kinds, arguments) {
    @extra = ""
    (str.bytes(arguments) > 0) {
        extra = " {arguments}"
    }
    @lines = ["[Desktop Entry]", "Type=Application", "Name={title}", "Comment={comment}", "Exec={binary}{extra}", "Path={root}", "Icon={face}", "Terminal=false", "Categories={kinds}"]
    out str.concat(str.join(lines, "\n"), "\n")
}

skill refresh() {
    process.run(["kbuildsycoca6"], "", []) rescue |err| { out none }
    out none
}

skill must(code, what) {
    ((code == 0) == no) {
        io.show("ошибка: {what} — код {code}")
        out error.InstallFailed
    }
    out none
}

program(name) {
    @found = entry(name)
    (group.count(found) == 0) {
        io.show("нет программы «{name}». Можно поставить:")
        drum (PROGRAMS) {
            @known = group.get(beat, 0)
            @title = group.get(beat, 2)
            io.show("  {known} — {title}")
        }
        out error.InstallFailed
    }
    @source = group.get(found, 1)
    @title = group.get(found, 2)
    @home = variable("HOME")
    @root = folder_of(["pwd"])
    @built = ".cache/build/{name}"
    @binary = "{home}/.local/bin/{name}"
    @icons = "{home}/.local/share/icons"
    @menu = "{home}/.local/share/applications"
    @card = "{menu}/saltic-{name}.desktop"
    @desk = folder_of(["xdg-user-dir", "DESKTOP"])
    (str.bytes(desk) == 0) { desk = "{home}/Desktop" }

    @saltic = variable("SALTIC_HOME")
    (str.bytes(saltic) == 0) { saltic = "../saltic" }
    io.show("1/5 собираю {source} (компилятор — {saltic}/bootstrap/saltic)")
    must(process.run(["{saltic}/bootstrap/saltic", source, built, HEAP, "x86_64"], "", []), "сборка")
    io.show("2/5 кладу бинарник в {binary}")
    must(process.run(["install", "-Dm755", built, binary], "", []), "копирование бинарника")
    io.show("3/5 ставлю иконку в {icons}")
    must(process.run(["mkdir", "-p", icons, menu, desk], "", []), "папки")
    @shown = picture(found, icons, name)
    io.show("4/5 пишу визитку {card} и ярлык на рабочий стол")
    @text = visiting(title, group.get(found, 3), binary, root, shown, group.get(found, 4), group.get(found, 6))
    file.write(card, text)
    @shortcut = "{desk}/saltic-{name}.desktop"
    file.write(shortcut, text)
    must(process.run(["chmod", "+x", card, shortcut], "", []), "права визитки")
    io.show("5/5 обновляю меню приложений")
    refresh()
    io.show("готово: «{title}» в меню и на рабочем столе")
    out none
}
